@model I_HAVE_GAME.ViewModels.GameUpdateListViewModel
@{ ViewData["Title"] = $"อัปเดต {Model.Game.Title}"; }
<section class="updates-page"><a asp-controller="Catalog" asp-action="Details" asp-route-slug="@Model.Game.Slug" class="back-link"><i class="fas fa-arrow-left"></i> กลับไปหน้าเกม</a><span class="eyebrow">PATCH NOTES & NEWS</span><h1>อัปเดตของ @Model.Game.Title</h1><p>ดูสิ่งที่เปลี่ยนแปลงและข่าวสารที่ผู้ดูแลเพิ่มให้เกมนี้</p><div class="update-timeline">@if (Model.Updates.Count == 0) { <div class="empty-catalog"><i class="fas fa-clock"></i><h2>ยังไม่มีรายการอัปเดต</h2><p>ผู้ดูแลจะเพิ่ม Patch Notes ของเกมนี้ที่นี่</p></div> } else { @foreach (var update in Model.Updates) { <article class="update-entry"><time>@update.PublishedAt.ToString("d MMMM yyyy")</time><h2>@update.Title</h2><p>@update.Description</p></article> } }</div></section>
