@model I_HAVE_GAME.Models.Game
<a class="catalog-card game-card-rich" asp-controller="Catalog" asp-action="Details" asp-route-slug="@Model.Slug">
    <div class="game-cover">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="หน้าปก @Model.Title" /> } else { <i class="fas fa-gamepad"></i> }
        <span>@Model.Genres?.Split(',').FirstOrDefault()</span>
        <div class="game-hover"><strong>ดูเกมนี้</strong><small>@Model.Description</small><span class="game-update-chip"><i class="fas fa-clipboard-list"></i> มีไทม์ไลน์เกม</span></div>
    </div>
    <div class="catalog-card-body"><h3>@Model.Title</h3><p>@Model.Platforms</p><div><span class="rating"><i class="fas fa-star"></i> @Model.Rating?.ToString("0.0")</span><span>@(Model.Price.HasValue ? "$" + Model.Price.Value.ToString("0.00") : "ราคาไม่ระบุ")</span></div></div>
</a>
