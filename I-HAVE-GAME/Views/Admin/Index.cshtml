@{
    ViewData["Title"] = "จัดการระบบ";
    var gameCount = (int)(ViewData["GameCount"] ?? 0);
    var quizCount = (int)(ViewData["QuizCount"] ?? 0);
}

<section class="admin-dashboard">
    <div class="admin-dashboard-header">
        <span class="eyebrow">ADMIN CENTER</span>
        <h1>จัดการเนื้อหาเว็บไซต์</h1>
        <p>สวัสดี @ViewData["AdminUsername"] เพิ่มเกม อัปโหลดรูปปก และดูแลคำถามสำหรับ Game Buddy ได้จากที่เดียว</p>
    </div>

    <div class="admin-dashboard-grid">
        <a asp-action="GameList" class="admin-dashboard-card">
            <i class="fas fa-gamepad"></i>
            <div><span class="admin-stat">@gameCount</span><h2>คลังเกม</h2><p>เพิ่ม แก้ไข หรือลบเกมและรูปปก</p></div>
            <span class="admin-card-action">จัดการเกม <i class="fas fa-arrow-right"></i></span>
        </a>
        <a asp-action="QuizQuestionList" class="admin-dashboard-card">
            <i class="fas fa-circle-question"></i>
            <div><span class="admin-stat">@quizCount</span><h2>คำถาม Game Buddy</h2><p>เพิ่มและแก้ไขคำถามเพื่อใช้หาเหรียญในมินิเกม</p></div>
            <span class="admin-card-action">จัดการคำถาม <i class="fas fa-arrow-right"></i></span>
        </a>
    </div>

    <div class="admin-tips">
        <i class="fas fa-lightbulb"></i>
        <div><h2>เริ่มต้นอย่างรวดเร็ว</h2><p>เพิ่มเกมใหม่จากคลังเกม แล้วอัปโหลดรูป PNG, JPG หรือ WebP ขนาดไม่เกิน 5 MB เกมจะปรากฏในแคตตาล็อกและระบบช่วยเลือกเกมทันที</p></div>
        <a asp-action="CreateGame" class="btn btn-primary">เพิ่มเกมใหม่</a>
    </div>
</section>
