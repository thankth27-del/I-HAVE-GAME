@model I_HAVE_GAME.ViewModels.GameUpdateListViewModel
@{ ViewData["Title"] = $"อัปเดต {Model.Game.Title}"; }
<section class="admin-games updates-admin"><a asp-action="GameList" class="back-link"><i class="fas fa-arrow-left"></i> กลับไปจัดการเกม</a><div class="admin-page-heading"><div><span class="eyebrow">GAME UPDATES</span><h1>@Model.Game.Title</h1><p>เพิ่ม Patch Notes หรือรายละเอียดอัปเดตที่ผู้เล่นจะเห็น</p></div></div>@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }<form asp-action="AddUpdate" class="game-form" method="post">@Html.AntiForgeryToken()<input type="hidden" name="gameId" value="@Model.Game.Id" /><label class="form-label">หัวข้ออัปเดต *</label><input name="title" class="form-control" placeholder="เช่น Patch 1.2: เพิ่มโหมด Co-op" required /><label class="form-label">รายละเอียด</label><textarea name="description" class="form-control" rows="5" placeholder="อธิบายสิ่งที่เพิ่ม แก้ไข หรือเปลี่ยนแปลง"></textarea><label class="form-label">วันที่เผยแพร่</label><input name="publishedAt" type="date" class="form-control" /><div class="form-actions"><button class="btn btn-primary">เพิ่มอัปเดต</button></div></form><div class="update-timeline admin-timeline">@foreach (var update in Model.Updates) { <article class="update-entry"><time>@update.PublishedAt.ToString("d MMMM yyyy")</time><h2>@update.Title</h2><p>@update.Description</p><form asp-action="DeleteUpdate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@update.Id" /><input type="hidden" name="gameId" value="@Model.Game.Id" /><button class="btn btn-outline-danger btn-sm">ลบ</button></form></article> }</div></section>
