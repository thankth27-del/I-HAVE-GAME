@model IReadOnlyList<I_HAVE_GAME.Models.Game>
@{ ViewData["Title"] = "จัดการเกม"; }
<div class="admin-games"><div class="admin-page-heading"><div><span class="eyebrow">ADMIN</span><h1>จัดการเกม</h1><p>เพิ่ม แก้ไข หรือลบเกมที่จะแสดงในแคตตาล็อก</p></div><a asp-action="CreateGame" class="btn btn-primary"><i class="fas fa-plus"></i> เพิ่มเกม</a></div>
@if (TempData["SuccessMessage"] is string message) { <div class="alert alert-success">@message</div> }
<div class="table-responsive"><table class="table admin-games-table"><thead><tr><th>เกม</th><th>แนวเกม</th><th>คะแนน</th><th>ราคา</th><th></th></tr></thead><tbody>@foreach (var game in Model) { <tr><td><strong>@game.Title</strong><small>@game.Platforms</small></td><td>@game.Genres</td><td>@game.Rating?.ToString("0.0")</td><td>@(game.Price.HasValue ? "$" + game.Price.Value.ToString("0.00") : "—")</td><td class="table-actions"><a asp-action="ManageUpdates" asp-route-id="@game.Id" class="btn btn-outline-primary btn-sm">อัปเดต</a><a asp-action="EditGame" asp-route-id="@game.Id" class="btn btn-outline-primary btn-sm">แก้ไข</a><form asp-action="DeleteGame" method="post"><input type="hidden" name="id" value="@game.Id" />@Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('ลบเกมนี้ใช่หรือไม่?');">ลบ</button></form></td></tr>}</tbody></table></div></div>
