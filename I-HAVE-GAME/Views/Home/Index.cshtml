@model I_HAVE_GAME.ViewModels.HomePageViewModel
@{ ViewData["Title"] = "I-HAVE-GAME | เกมที่ใช่สำหรับคุณ"; var spotlight = Model.SpotlightGame; }

@if (spotlight is not null)
{
    <section class="spotlight" style="background-image: linear-gradient(90deg, rgba(11,20,30,.96) 0%, rgba(16,30,43,.82) 48%, rgba(16,30,43,.30) 100%), url('@spotlight.ImageUrl');">
        <div class="spotlight-content"><span class="eyebrow">SPOTLIGHT GAME</span><h1>@spotlight.Title</h1><p>@(string.IsNullOrWhiteSpace(spotlight.Description) ? "เกมเด่นที่คัดมาให้สำหรับเกมเมอร์" : spotlight.Description)</p><div class="spotlight-meta"><span><i class="fas fa-star"></i> @spotlight.Rating?.ToString("0.0")</span><span>@spotlight.Genres</span><span>@spotlight.Platforms</span></div><div class="hero-actions"><a asp-controller="Catalog" asp-action="Details" asp-route-slug="@spotlight.Slug" class="btn btn-primary">ดูรายละเอียดเกม</a><a asp-action="Surprise" class="btn btn-ghost"><i class="fas fa-dice"></i> สุ่มเกมให้ฉัน</a></div></div>
    </section>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <section class="player-hub"><div><span class="eyebrow">PLAYER HUB</span><h2>คลังเกมของคุณ</h2></div><div class="player-stats"><a asp-controller="GameLibrary" asp-action="Index"><strong>@Model.WishlistCount</strong><span>อยากเล่น</span></a><a asp-controller="GameLibrary" asp-action="Index"><strong>@Model.BacklogCount</strong><span>รอเล่น</span></a><a asp-controller="GameLibrary" asp-action="Index"><strong>@Model.PlayedCount</strong><span>เล่นจบ</span></a></div><a asp-controller="Matcher" asp-action="Index" class="btn btn-outline-primary">ไม่รู้จะเล่นอะไร? <i class="fas fa-wand-magic-sparkles"></i></a></section>
}
else
{
    <section class="join-banner"><div><span class="eyebrow">YOUR GAME SPACE</span><h2>จัดเกมที่อยากเล่นให้เป็นของคุณ</h2><p>สร้างคลังเกมส่วนตัว ติดตามเกมที่กำลังเล่น และให้เราช่วยเลือกเกมถัดไป</p></div><a asp-controller="Account" asp-action="Register" class="btn btn-primary">สร้างบัญชีฟรี</a></section>
}

<section class="game-news-banner"><div><span class="eyebrow">GAME TIMELINE</span><h2>เกมออกวันไหน? มีอะไรอัปเดตบ้าง?</h2><p>ดูวันวางจำหน่ายและ Patch Notes ของทุกเกมในคลังเราได้ในที่เดียว</p></div><div class="game-news-actions"><a asp-controller="GameUpdates" asp-action="Calendar" class="btn btn-primary"><i class="fas fa-calendar-days"></i> เปิดปฏิทินเกม</a><a asp-controller="Catalog" asp-action="Index" class="btn btn-ghost"><i class="fas fa-clipboard-list"></i> ดูหน้าเกม</a></div></section>
<section class="home-section"><div class="section-heading"><div><span class="eyebrow">TOP RATED</span><h2>เกมที่เกมเมอร์ไม่ควรพลาด</h2></div><a asp-controller="Catalog" asp-action="Index">ดูทั้งหมด <i class="fas fa-arrow-right"></i></a></div><div class="game-rail">@foreach (var game in Model.TopGames) { <partial name="_GameCard" model="game" /> }</div></section>

<section class="genre-explorer"><span class="eyebrow">EXPLORE BY MOOD</span><h2>วันนี้อยากเล่นแบบไหน?</h2><div class="mood-grid"><a asp-controller="Catalog" asp-action="Index" asp-route-genre="Action"><i class="fas fa-burst"></i><strong>มันส์สะใจ</strong><span>Action</span></a><a asp-controller="Catalog" asp-action="Index" asp-route-genre="RPG"><i class="fas fa-hat-wizard"></i><strong>ผจญภัยยาว ๆ</strong><span>RPG</span></a><a asp-controller="Catalog" asp-action="Index" asp-route-genre="Puzzle"><i class="fas fa-puzzle-piece"></i><strong>ชิลแต่ใช้สมอง</strong><span>Puzzle</span></a><a asp-controller="Catalog" asp-action="Index" asp-route-platform="PC"><i class="fas fa-computer"></i><strong>เล่นบน PC</strong><span>PC Games</span></a></div></section>

@foreach (var shelf in Model.GenreShelves.Where(item => item.Value.Count > 0))
{
    <section class="home-section"><div class="section-heading"><h2>@shelf.Key</h2><a asp-controller="Catalog" asp-action="Index">สำรวจเพิ่ม <i class="fas fa-arrow-right"></i></a></div><div class="game-rail">@foreach (var game in shelf.Value) { <partial name="_GameCard" model="game" /> }</div></section>
}

<section class="feature-strip"><div><i class="fas fa-dice"></i><h3>สุ่มแล้วลุย</h3><p>ให้เกมหนึ่งเกมตัดสินใจแทนคุณ</p></div><div><i class="fas fa-bookmark"></i><h3>คลังของคุณ</h3><p>เก็บเกมที่อยากเล่น กำลังเล่น และเล่นจบไว้เป็นที่เดียว</p></div><div><i class="fas fa-wand-magic-sparkles"></i><h3>เลือกเกมให้ตรงใจ</h3><p>ตอบคำถาม 5 ข้อ แล้วเจอเกมที่เหมาะกับวันนี้</p></div></section>
