@model I_HAVE_GAME.ViewModels.GameSearchViewModel
@using I_HAVE_GAME.ViewModels
@{ ViewData["Title"] = "ช่วยเลือกเกม"; }
<section class="wizard-header"><span class="eyebrow">GAME MATCHER</span><h1>วันนี้อยากเล่นเกมแบบไหน?</h1><p>ตอบคำถามสั้น ๆ 5 ข้อ แล้วเราจะเลือกเกมจากคลังที่คุณเพิ่มไว้ให้</p><div class="wizard-progress"><span>คำถาม @Model.CurrentStep / 5</span><div><i style="width:@((Model.CurrentStep / 5.0) * 100)%"></i></div></div></section>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
@if (!string.IsNullOrWhiteSpace(Model.WarningMessage)) { <div class="alert alert-info">@Model.WarningMessage</div> }
@if (Model.Results.Count == 0) { <form asp-action="Choose" method="post" class="wizard-card">@Html.AntiForgeryToken()<input type="hidden" name="CurrentStep" value="@Model.CurrentStep" /><input type="hidden" name="SelectedGenre" value="@Model.SelectedGenre" /><input type="hidden" name="SelectedDevice" value="@Model.SelectedDevice" /><input type="hidden" name="SelectedPlayMode" value="@Model.SelectedPlayMode" /><input type="hidden" name="SelectedBudget" value="@Model.SelectedBudget" /><input type="hidden" name="SelectedEra" value="@Model.SelectedEra" /><h2>@switch (Model.CurrentStep) { case 1: <text>คุณอยากเล่นเกมแนวไหน?</text>; break; case 2: <text>คุณจะเล่นบนแพลตฟอร์มใด?</text>; break; case 3: <text>อยากเล่นคนเดียวหรือกับเพื่อน?</text>; break; case 4: <text>งบประมาณของคุณเป็นแบบไหน?</text>; break; default: <text>อยากเล่นเกมช่วงเวลาไหน?</text>; break; }</h2><div class="wizard-options">@{ var options = Model.CurrentStep switch { 1 => GameSearchViewModel.GenreOptions, 2 => GameSearchViewModel.DeviceOptions, 3 => GameSearchViewModel.PlayModeOptions, 4 => GameSearchViewModel.BudgetOptions, _ => GameSearchViewModel.EraOptions }; var field = Model.CurrentStep switch { 1 => "SelectedGenre", 2 => "SelectedDevice", 3 => "SelectedPlayMode", 4 => "SelectedBudget", _ => "SelectedEra" }; foreach (var option in options) { var id = $"choice_{Model.CurrentStep}_{option.Value}".Replace("+", "plus"); <input class="btn-check" type="radio" name="@field" id="@id" value="@option.Value" /><label class="wizard-option" for="@id">@option.Label</label> } }</div><div class="wizard-actions">@if (Model.CurrentStep > 1) { <button class="btn btn-outline-primary" name="Action" value="previous">ย้อนกลับ</button> } else { <span></span> }<button class="btn btn-primary" name="Action" value="@(Model.CurrentStep == 5 ? "complete" : "next")">@(Model.CurrentStep == 5 ? "ดูเกมที่แนะนำ" : "ถัดไป") <i class="fas fa-arrow-right"></i></button></div></form> } else { <section class="matcher-results"><div class="results-heading"><div><span class="eyebrow">YOUR MATCHES</span><h2>เกมที่น่าจะเหมาะกับคุณ</h2></div><a asp-action="Index" class="btn btn-outline-primary">เริ่มเลือกใหม่</a></div><div class="catalog-grid">@foreach (var game in Model.Results) { <a class="catalog-card" asp-controller="Catalog" asp-action="Details" asp-route-slug="@game.Slug"><div class="game-cover"><i class="fas fa-gamepad"></i><span>@game.Genres.FirstOrDefault()</span></div><div class="catalog-card-body"><h3>@game.Name</h3><p>@game.Platforms.FirstOrDefault()</p><div><span class="rating"><i class="fas fa-star"></i> @game.Rating.ToString("0.0")</span><span>@game.ReleasedDate</span></div></div></a>}</div></section> }
