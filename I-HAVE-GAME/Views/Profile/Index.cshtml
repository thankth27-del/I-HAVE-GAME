@model I_HAVE_GAME.ViewModels.ProfileViewModel
@{ ViewData["Title"] = "โปรไฟล์เกมเมอร์"; var displayName = Model.Nickname is "" or "Not set" ? Model.Username : Model.Nickname; }
<section class="gamer-profile">
    @if (TempData["ProfileSuccess"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["ProfileError"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="profile-hero"><div class="profile-avatar-large">@if (!string.IsNullOrWhiteSpace(Model.AvatarUrl)) { <img src="@Model.AvatarUrl" alt="รูปโปรไฟล์ @displayName" /> } else { <i class="fas fa-user-astronaut"></i> }</div><div><span class="eyebrow">GAMER PROFILE</span><h1>@displayName</h1><p class="profile-handle">@@@Model.Username · เล่นเกมมาตั้งแต่ @Model.MemberSince</p><p class="profile-bio">@(string.IsNullOrWhiteSpace(Model.Bio) ? "ยังไม่ได้เขียน Bio — บอกเพื่อนเกมเมอร์หน่อยว่าคุณเป็นสายไหน" : Model.Bio)</p>@if (!string.IsNullOrWhiteSpace(Model.FavoriteGenresText)) { <div class="genre-tags">@foreach (var genre in Model.FavoriteGenresText.Split(',', StringSplitOptions.RemoveEmptyEntries)) { <span>@genre.Trim()</span> }</div> }</div><button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#profile-editor"><i class="fas fa-pen"></i> แก้ไขโปรไฟล์</button></div>
    <div id="profile-editor" class="collapse profile-editor"><form asp-action="Update" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<div class="profile-edit-grid"><div><label class="form-label">ชื่อที่แสดง</label><input asp-for="Nickname" class="form-control" placeholder="ชื่อที่อยากให้คนอื่นเรียก" /></div><div><label class="form-label">อุปกรณ์หลัก</label><input asp-for="MainDevice" class="form-control" placeholder="เช่น PC, PS5, Nintendo Switch" /></div><div><label class="form-label">แนวเกมที่ชอบ</label><input asp-for="FavoriteGenresText" class="form-control" placeholder="เช่น RPG, Indie, Co-op" /></div><div><label class="form-label">รูปโปรไฟล์</label><input asp-for="AvatarImage" class="form-control" accept=".jpg,.jpeg,.png,.webp" /><small class="form-hint">JPG, PNG, WebP ไม่เกิน 3 MB</small></div></div><label class="form-label">Bio</label><textarea asp-for="Bio" class="form-control" rows="3" maxlength="500" placeholder="เล่าเรื่องสั้น ๆ เกี่ยวกับสไตล์การเล่นเกมของคุณ"></textarea><button class="btn btn-primary profile-save"><i class="fas fa-save"></i> บันทึกโปรไฟล์</button></form></div>
    <div class="profile-stats"><a asp-controller="GameLibrary" asp-action="Index"><i class="fas fa-circle-check"></i><strong>@Model.TotalPlayedCount</strong><span>เล่นจบ</span></a><a asp-controller="GameLibrary" asp-action="Index"><i class="fas fa-layer-group"></i><strong>@Model.TotalBacklogCount</strong><span>กำลังรอเล่น</span></a><a asp-controller="GameLibrary" asp-action="Index"><i class="fas fa-heart"></i><strong>@Model.TotalWishlistCount</strong><span>อยากเล่น</span></a><div><i class="fas fa-star"></i><strong>@Model.AverageRating.ToString("0.0")</strong><span>คะแนนเฉลี่ย</span></div></div>
    <div class="profile-columns"><section class="profile-panel"><div class="section-heading"><div><span class="eyebrow">GAME DNA</span><h2>แนวเกมที่คุณชอบ</h2></div></div>@if (Model.FavoriteGenres.Any()) { <div class="genre-ranking">@foreach (var genre in Model.FavoriteGenres.Take(5)) { <div><span>@genre.Genre</span><b style="width:@Math.Min(100, genre.Count * 25)%"></b><strong>@genre.Count เกม</strong></div> }</div> } else { <p class="profile-empty">เพิ่มเกมที่เล่นจบแล้ว ระบบจะวิเคราะห์แนวเกมที่คุณชอบให้</p> }</section><section class="profile-panel"><div class="section-heading"><div><span class="eyebrow">ACHIEVEMENTS</span><h2>ตรานักเล่นเกม</h2></div><span class="achievement-total">@Model.Achievements.Count(item => item.Unlocked) / @Model.Achievements.Count</span></div><div class="achievement-grid">@foreach (var achievement in Model.Achievements) { <div class="achievement @(achievement.Unlocked ? "unlocked" : "locked")"><i class="fas @achievement.Icon"></i><div><strong>@achievement.Title</strong><span>@achievement.Description</span></div></div> }</div></section></div>
</section>
