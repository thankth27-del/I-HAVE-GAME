@model I_HAVE_GAME.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container-fluid py-5">
    <!-- Header -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-10">
            <div class="d-flex align-items-center gap-4 mb-4">
                <div class="profile-avatar">
                    <i class="fas fa-user-circle"></i>
                </div>
                <div>
                    <h1 class="display-6 fw-bold mb-2">
                        <i class="fas fa-user" style="color: #2D5A8C;"></i> @Model.Username
                    </h1>
                    <p class="lead text-muted mb-0">Member since @Model.MemberSince</p>
                </div>
            </div>
        </div>
    </div>

    <!-- User Information Cards -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-10">
            <div class="row g-3">
                <!-- Email Card -->
                <div class="col-md-6">
                    <div class="info-card">
                        <div class="info-card-header">
                            <i class="fas fa-envelope"></i>
                            <span>Email</span>
                        </div>
                        <div class="info-card-body">
                            <p>@Model.Email</p>
                        </div>
                    </div>
                </div>

                <!-- Nickname Card -->
                <div class="col-md-6">
                    <div class="info-card">
                        <div class="info-card-header">
                            <i class="fas fa-tag"></i>
                            <span>Nickname</span>
                        </div>
                        <div class="info-card-body">
                            <p>@Model.Nickname</p>
                        </div>
                    </div>
                </div>

                <!-- Main Device Card -->
                <div class="col-md-6">
                    <div class="info-card">
                        <div class="info-card-header">
                            <i class="fas fa-desktop"></i>
                            <span>Main Device</span>
                        </div>
                        <div class="info-card-body">
                            <p>@Model.MainDevice</p>
                        </div>
                    </div>
                </div>

                <!-- Account Age Card -->
                <div class="col-md-6">
                    <div class="info-card">
                        <div class="info-card-header">
                            <i class="fas fa-calendar"></i>
                            <span>Account Age</span>
                        </div>
                        <div class="info-card-body">
                            <p>@Model.AccountAgeDays day@(Model.AccountAgeDays != 1 ? "s" : "")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Section -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-10">
            <h2 class="h4 fw-bold mb-4">
                <i class="fas fa-chart-bar" style="color: #2D5A8C;"></i> Library Statistics
            </h2>

            <div class="row g-3">
                <!-- Played Games -->
                <div class="col-sm-6 col-md-4">
                    <div class="stat-card">
                        <div class="stat-card-icon" style="background-color: rgba(45, 90, 140, 0.1);">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-card-content">
                            <h3 class="stat-value">@Model.TotalPlayedCount</h3>
                            <p class="stat-label">Games Played</p>
                        </div>
                    </div>
                </div>

                <!-- Wishlist Games -->
                <div class="col-sm-6 col-md-4">
                    <div class="stat-card">
                        <div class="stat-card-icon" style="background-color: rgba(45, 90, 140, 0.1);">
                            <i class="fas fa-heart"></i>
                        </div>
                        <div class="stat-card-content">
                            <h3 class="stat-value">@Model.TotalWishlistCount</h3>
                            <p class="stat-label">Wishlist</p>
                        </div>
                    </div>
                </div>

                <!-- Backlog Games -->
                <div class="col-sm-6 col-md-4">
                    <div class="stat-card">
                        <div class="stat-card-icon" style="background-color: rgba(45, 90, 140, 0.1);">
                            <i class="fas fa-list"></i>
                        </div>
                        <div class="stat-card-content">
                            <h3 class="stat-value">@Model.TotalBacklogCount</h3>
                            <p class="stat-label">Backlog</p>
                        </div>
                    </div>
                </div>

                <!-- Average Rating -->
                <div class="col-sm-6 col-md-4">
                    <div class="stat-card">
                        <div class="stat-card-icon" style="background-color: rgba(45, 90, 140, 0.1);">
                            <i class="fas fa-star"></i>
                        </div>
                        <div class="stat-card-content">
                            <h3 class="stat-value">@Model.AverageRating.ToString("F1")</h3>
                            <p class="stat-label">Average Rating</p>
                        </div>
                    </div>
                </div>

                <!-- Total Searches -->
                <div class="col-sm-6 col-md-4">
                    <div class="stat-card">
                        <div class="stat-card-icon" style="background-color: rgba(45, 90, 140, 0.1);">
                            <i class="fas fa-search"></i>
                        </div>
                        <div class="stat-card-content">
                            <h3 class="stat-value">@Model.TotalSearchCount</h3>
                            <p class="stat-label">Total Searches</p>
                        </div>
                    </div>
                </div>

                <!-- Total Library -->
                <div class="col-sm-6 col-md-4">
                    <div class="stat-card">
                        <div class="stat-card-icon" style="background-color: rgba(45, 90, 140, 0.1);">
                            <i class="fas fa-book"></i>
                        </div>
                        <div class="stat-card-content">
                            <h3 class="stat-value">@Model.TotalLibrarySize</h3>
                            <p class="stat-label">Total Library Size</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-10">
            <!-- Search Activity Chart -->
            @if (Model.SearchActivityData.Any())
            {
                <div class="mb-5">
                    <h2 class="h4 fw-bold mb-4">
                        <i class="fas fa-chart-line" style="color: #2D5A8C;"></i> Search Activity (Last 30 Days)
                    </h2>

                    <div class="chart-container">
                        <div class="chart-card">
                            <canvas id="searchActivityChart"></canvas>
                        </div>
                    </div>
                </div>
            }

            <!-- Genre Proportion Chart -->
            @if (Model.GenreProportionData.Any())
            {
                <div class="mb-5">
                    <h2 class="h4 fw-bold mb-4">
                        <i class="fas fa-pie-chart" style="color: #2D5A8C;"></i> Favorite Genres
                    </h2>

                    <div class="chart-container">
                        <div class="chart-card">
                            <canvas id="genreProportionChart"></canvas>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-5">
                    <i class="fas fa-info-circle"></i> You haven't played any rated games yet. Start adding games to your library to see your favorite genres!
                </div>
            }
        </div>
    </div>
</div>

<style>
    .profile-avatar {
        font-size: 80px;
        color: var(--accent-primary);
        width: 100px;
        height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--bg-secondary);
        border-radius: 50%;
        border: 2px solid var(--accent-primary);
    }

    .info-card {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 2px 4px var(--shadow-light);
        transition: all 0.3s ease;
    }

    .info-card:hover {
        box-shadow: 0 4px 8px var(--shadow-light);
        border-color: var(--accent-primary);
    }

    .info-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .info-card-header i {
        color: var(--accent-primary);
        font-size: 18px;
    }

    .info-card-body p {
        margin-bottom: 0;
        color: var(--text-primary);
        word-break: break-word;
    }

    .stat-card {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 2px 4px var(--shadow-light);
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px var(--shadow-light);
        border-color: var(--accent-primary);
    }

    .stat-card-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 28px;
        color: var(--accent-primary);
        flex-shrink: 0;
    }

    .stat-card-content {
        flex: 1;
    }

    .stat-value {
        font-size: 28px;
        font-weight: bold;
        color: var(--accent-primary);
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 0;
    }

    .chart-container {
        display: flex;
        justify-content: center;
    }

    .chart-card {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 20px;
        width: 100%;
        max-width: 100%;
        box-shadow: 0 2px 4px var(--shadow-light);
    }

    canvas {
        display: block;
        margin: 0 auto;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .profile-avatar {
            width: 60px;
            height: 60px;
            font-size: 50px;
        }

        h1.display-6 {
            font-size: 28px;
        }

        .stat-card-icon {
            width: 50px;
            height: 50px;
            font-size: 24px;
        }

        .stat-value {
            font-size: 24px;
        }

        .info-card {
            padding: 15px;
        }

        .stat-card {
            padding: 15px;
        }
    }

    @@media (max-width: 480px) {
        .profile-avatar {
            width: 50px;
            height: 50px;
            font-size: 40px;
        }

        h1.display-6 {
            font-size: 22px;
        }

        .stat-card {
            flex-direction: column;
            text-align: center;
        }

        .stat-card-icon {
            width: 40px;
            height: 40px;
            font-size: 20px;
        }

        .stat-value {
            font-size: 20px;
        }

        .info-card {
            padding: 12px;
        }

        .chart-card {
            padding: 15px;
        }
    }

    /* Dark mode compatibility */
    :root[data-bs-theme="dark"] .info-card,
    [data-bs-theme="dark"] .info-card {
        background-color: var(--bg-secondary);
        border-color: var(--border-light);
    }

    :root[data-bs-theme="dark"] .stat-card,
    [data-bs-theme="dark"] .stat-card {
        background-color: var(--bg-secondary);
        border-color: var(--border-light);
    }

    :root[data-bs-theme="dark"] .chart-card,
    [data-bs-theme="dark"] .chart-card {
        background-color: var(--bg-secondary);
        border-color: var(--border-light);
    }
</style>

<!-- Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
    // Determine theme for charts
    const isDarkMode = document.documentElement.getAttribute('data-bs-theme') === 'dark' || 
                       document.body.getAttribute('data-bs-theme') === 'dark';

    const textColor = getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#333';
    const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent-primary').trim() || '#2D5A8C';
    const borderColor = getComputedStyle(document.documentElement).getPropertyValue('--border-light').trim() || '#ddd';

    // Search Activity Chart
    const searchActivityCanvas = document.getElementById('searchActivityChart');
    if (searchActivityCanvas) {
        const searchActivityCtx = searchActivityCanvas.getContext('2d');
        new Chart(searchActivityCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SearchActivityData.Select(s => s.Date))),
                datasets: [{
                    label: 'Searches',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SearchActivityData.Select(s => s.SearchCount))),
                    borderColor: accentColor,
                    backgroundColor: accentColor + '20',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: accentColor,
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        display: true,
                        labels: {
                            color: textColor,
                            font: { size: 12 }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { color: borderColor + '40' },
                        ticks: { color: textColor }
                    },
                    y: {
                        grid: { color: borderColor + '40' },
                        ticks: { color: textColor, beginAtZero: true }
                    }
                }
            }
        });
    }

    // Genre Proportion Chart
    const genreProportionCanvas = document.getElementById('genreProportionChart');
    if (genreProportionCanvas) {
        const genreProportionCtx = genreProportionCanvas.getContext('2d');

        // Generate colors for pie chart
        const colors = [
            '#2D5A8C', '#4A90E2', '#7CB9E8', '#B8D5E8', '#5B7FA6',
            '#6EA3D4', '#8AB5D9', '#A5C4DE', '#3D6B9E', '#1F4E78'
        ];

        new Chart(genreProportionCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GenreProportionData.Select(g => g.Genre + " (" + g.Percentage + "%)"))),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GenreProportionData.Select(g => g.Count))),
                    backgroundColor: colors,
                    borderColor: getComputedStyle(document.documentElement).getPropertyValue('--bg-secondary').trim() || '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: textColor,
                            font: { size: 12 },
                            padding: 15
                        }
                    }
                }
            }
        });
    }
</script>
