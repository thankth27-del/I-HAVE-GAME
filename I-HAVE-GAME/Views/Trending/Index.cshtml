@model I_HAVE_GAME.ViewModels.TrendingGamesViewModel

@{
    ViewData["Title"] = "Weekly Trending Games";
}

<div class="container-fluid py-5">
    <div class="row justify-content-center mb-5">
        <div class="col-md-10">
            <h1 class="display-5 fw-bold mb-2">
                <i class="fas fa-fire" style="color: #2D5A8C;"></i> Weekly Trending Games
            </h1>
            <p class="lead text-muted">
                Discover the hottest games rated highly this week on RAWG
            </p>
        </div>
    </div>

    <!-- Message Alert -->
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="row justify-content-center mb-4">
            <div class="col-md-10">
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    <i class="fas fa-info-circle"></i> @Model.Message
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        </div>
    }

    <!-- Trending Games Grid -->
    @if (Model.TrendingGames.Any())
    {
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="games-grid">
                    @foreach (var game in Model.TrendingGames)
                    {
                        <div class="game-card">
                            <div class="game-card-image-wrapper">
                                @if (!string.IsNullOrEmpty(game.BackgroundImage))
                                {
                                    <img src="@game.BackgroundImage" alt="@game.Name" class="game-card-image" loading="lazy">
                                }
                                else
                                {
                                    <div class="game-card-image-placeholder">
                                        <i class="fas fa-gamepad"></i>
                                    </div>
                                }
                                <div class="game-card-rating">
                                    <span class="rating-badge">
                                        <i class="fas fa-star"></i> @game.Rating.ToString("F1")
                                    </span>
                                    <span class="ratings-count">
                                        (@game.RatingsCount)
                                    </span>
                                </div>
                            </div>
                            <div class="game-card-content">
                                <h5 class="game-title">@game.Name</h5>

                                @if (game.Genres.Any())
                                {
                                    <div class="game-genres">
                                        <small class="text-muted">
                                            @game.GenresDisplay
                                        </small>
                                    </div>
                                }

                                @if (game.Platforms.Any())
                                {
                                    <div class="game-platforms mt-2">
                                        <small class="text-muted">
                                            <i class="fas fa-desktop"></i> @game.PlatformsDisplay
                                        </small>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(game.Released))
                                {
                                    <div class="game-released mt-2">
                                        <small class="text-muted">
                                            <i class="fas fa-calendar"></i> @game.Released
                                        </small>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .games-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 20px;
        margin: 0;
    }

    .game-card {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
        box-shadow: 0 2px 4px var(--shadow-light);
    }

    .game-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 12px var(--shadow-light);
        border-color: var(--accent-primary);
    }

    .game-card-image-wrapper {
        position: relative;
        overflow: hidden;
        background-color: var(--bg-primary);
        aspect-ratio: 16 / 9;
    }

    .game-card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .game-card:hover .game-card-image {
        transform: scale(1.05);
    }

    .game-card-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        color: var(--text-secondary);
        background-color: var(--bg-primary);
    }

    .game-card-rating {
        position: absolute;
        top: 8px;
        right: 8px;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
    }

    .rating-badge {
        background-color: var(--accent-primary);
        color: white;
        padding: 6px 10px;
        border-radius: 6px;
        font-weight: bold;
        font-size: 14px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    }

    .ratings-count {
        background-color: rgba(0, 0, 0, 0.6);
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
    }

    .game-card-content {
        padding: 12px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .game-title {
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--text-primary);
        font-size: 14px;
        line-height: 1.3;
        word-break: break-word;
    }

    .game-genres,
    .game-platforms,
    .game-released {
        margin-top: 6px;
    }

    .game-genres small,
    .game-platforms small,
    .game-released small {
        display: block;
        font-size: 12px;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .games-grid {
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 15px;
        }

        .game-title {
            font-size: 13px;
        }

        .rating-badge {
            font-size: 12px;
            padding: 5px 8px;
        }
    }

    @@media (max-width: 480px) {
        .games-grid {
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 12px;
        }

        .game-card-content {
            padding: 10px;
        }

        .game-title {
            font-size: 12px;
        }

        .rating-badge {
            font-size: 11px;
            padding: 4px 6px;
        }

        .game-card-image-placeholder {
            font-size: 36px;
        }
    }

    /* Dark mode adjustments */
    :root[data-bs-theme="dark"] .game-card,
    [data-bs-theme="dark"] .game-card {
        background-color: var(--bg-secondary);
        border-color: var(--border-light);
    }

    :root[data-bs-theme="dark"] .game-title,
    [data-bs-theme="dark"] .game-title {
        color: var(--text-primary);
    }
</style>
