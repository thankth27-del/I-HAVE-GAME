@model RegisterViewModel

@{
    ViewData["Title"] = "สมัครสมาชิก";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="auth-title"><i class="fas fa-gamepad"></i> I-HAVE-GAME</h1>
            <p class="auth-subtitle">สมัครสมาชิกเพื่อเริ่มใช้งาน</p>
        </div>

        <form method="post" asp-action="Register" asp-controller="Account" class="auth-form">
            @{
                if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            }

            <div class="form-group">
                <label asp-for="Username" class="form-label">ชื่อผู้ใช้</label>
                <input asp-for="Username" class="form-control" placeholder="เลือกชื่อผู้ใช้ของคุณ">
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">อีเมล</label>
                <input asp-for="Email" class="form-control" placeholder="your@email.com">
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">รหัสผ่าน</label>
                <input asp-for="Password" class="form-control" placeholder="อย่างน้อย 6 ตัวอักษร">
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">ยืนยันรหัสผ่าน</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="ยืนยันรหัสผ่านของคุณ">
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg">สร้างบัญชี</button>
        </form>

        <div class="auth-footer">
            <p>มีบัญชีแล้ว? <a asp-action="Login" asp-controller="Account">เข้าสู่ระบบ</a></p>
        </div>
    </div>
</div>

<style>
    .auth-container {
        min-height: 100vh;
        background-color: var(--bg-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .auth-card {
        background-color: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 2px 8px var(--shadow-light);
    }

    .auth-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .auth-title {
        color: var(--accent-primary);
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .auth-subtitle {
        color: var(--text-secondary);
        font-size: 14px;
        margin: 0;
    }

    .auth-form .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        color: var(--text-primary);
        font-weight: 500;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .form-control {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        padding: 10px 15px;
        border-radius: 6px;
        font-size: 14px;
    }

    .form-control:focus {
        background-color: var(--bg-secondary);
        border-color: var(--accent-primary);
        color: var(--text-primary);
        box-shadow: 0 0 0 0.2rem rgba(0, 102, 204, 0.25);
    }

    .form-control::placeholder {
        color: var(--text-tertiary);
    }

    .text-danger {
        color: #e74c3c;
        display: block;
        margin-top: 4px;
    }

    .btn-primary {
        background-color: var(--accent-primary);
        border: none;
        color: white;
        font-weight: 600;
        padding: 12px 20px;
        margin-top: 10px;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: var(--accent-primary-hover);
        color: white;
    }

    .auth-footer {
        text-align: center;
        margin-top: 20px;
        border-top: 1px solid var(--border-color);
        padding-top: 20px;
    }

    .auth-footer p {
        color: var(--text-secondary);
        margin: 0;
        font-size: 14px;
    }

    .auth-footer a {
        color: var(--accent-primary);
        text-decoration: none;
        font-weight: 600;
    }

    .auth-footer a:hover {
        color: var(--accent-primary-hover);
        text-decoration: underline;
    }

    .alert {
        border-radius: 6px;
        border: 1px solid #e74c3c;
        background-color: rgba(231, 76, 60, 0.1);
        color: #e74c3c;
        margin-bottom: 20px;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
