@model RegisterViewModel
@{ ViewData["Title"] = "สมัครสมาชิก"; }
<link rel="stylesheet" href="~/css/auth-page.css" />
<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header"><i class="fas fa-gamepad auth-icon"></i><h1 class="auth-title">สร้างบัญชี</h1><p class="auth-subtitle">เริ่มสร้างคลังเกมในแบบของคุณ</p></div>
        <form method="post" asp-action="Register" asp-controller="Account" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-group"><label asp-for="Username" class="form-label">ชื่อผู้ใช้</label><input asp-for="Username" class="form-control" placeholder="เลือกชื่อผู้ใช้ของคุณ" autocomplete="username" /><span asp-validation-for="Username" class="validation-error"></span></div>
            <div class="form-group"><label asp-for="Email" class="form-label">อีเมล</label><input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" /><span asp-validation-for="Email" class="validation-error"></span></div>
            <div class="form-group"><label asp-for="Password" class="form-label">รหัสผ่าน</label><input asp-for="Password" class="form-control" placeholder="อย่างน้อย 6 ตัวอักษร" autocomplete="new-password" /><span asp-validation-for="Password" class="validation-error"></span></div>
            <div class="form-group"><label asp-for="ConfirmPassword" class="form-label">ยืนยันรหัสผ่าน</label><input asp-for="ConfirmPassword" class="form-control" placeholder="ป้อนรหัสผ่านอีกครั้ง" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="validation-error"></span></div>
            <button type="submit" class="btn-auth">สร้างบัญชี</button>
        </form>
        <div class="auth-footer"><p>มีบัญชีอยู่แล้ว? <a asp-action="Login" asp-controller="Account">เข้าสู่ระบบ</a></p></div>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
