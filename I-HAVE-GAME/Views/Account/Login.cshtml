@model LoginViewModel

@{
    ViewData["Title"] = "เข้าสู่ระบบ";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="auth-title"><i class="fas fa-gamepad"></i> I-HAVE-GAME</h1>
            <p class="auth-subtitle">เข้าสู่ระบบเพื่อดำเนินการต่อ</p>
        </div>

        <form method="post" asp-action="Login" asp-controller="Account" class="auth-form">
            @{
                if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            }

            <div class="form-group">
                <label asp-for="UsernameOrEmail" class="form-label">ชื่อผู้ใช้หรืออีเมล</label>
                <input asp-for="UsernameOrEmail" class="form-control" placeholder="ป้อนชื่อผู้ใช้หรืออีเมล">
                <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">รหัสผ่าน</label>
                <input asp-for="Password" class="form-control" placeholder="ป้อนรหัสผ่านของคุณ">
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="rememberMe" asp-for="RememberMe">
                <label class="form-check-label" for="rememberMe">
                    จำฉันไว้สำหรับ 30 วัน
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg">เข้าสู่ระบบ</button>
        </form>

        <div class="auth-footer">
            <p>ยังไม่มีบัญชี? <a asp-action="Register" asp-controller="Account">สมัครสมาชิกทั้งนี้</a></p>
        </div>
    </div>
</div>

<style>
    .auth-container {
        min-height: 100vh;
        background-color: var(--bg-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .auth-card {
        background-color: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 2px 8px var(--shadow-light);
    }

    .auth-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .auth-title {
        color: var(--accent-primary);
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .auth-subtitle {
        color: var(--text-secondary);
        font-size: 14px;
        margin: 0;
    }

    .auth-form .form-group {
        margin-bottom: 18px;
    }

    .form-label {
        color: var(--text-primary);
        font-weight: 500;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .form-control {
        background-color: var(--bg-secondary);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        padding: 10px 15px;
        border-radius: 6px;
        font-size: 14px;
    }

    .form-control:focus {
        background-color: var(--bg-secondary);
        border-color: var(--accent-primary);
        color: var(--text-primary);
        box-shadow: 0 0 0 0.2rem rgba(0, 102, 204, 0.25);
    }

    .form-control::placeholder {
        color: var(--text-tertiary);
    }

    .form-check {
        color: var(--text-primary);
        font-size: 14px;
    }

    .form-check-input {
        width: 18px;
        height: 18px;
        cursor: pointer;
        border: 1px solid var(--border-color);
        background-color: var(--bg-secondary);
    }

    .form-check-input:checked {
        background-color: var(--accent-primary);
        border-color: var(--accent-primary);
    }

    .form-check-input:focus {
        border-color: var(--accent-primary);
        box-shadow: 0 0 0 0.2rem rgba(0, 102, 204, 0.25);
    }

    .form-check-label {
        cursor: pointer;
        margin-left: 8px;
    }

    .text-danger {
        color: #e74c3c;
        display: block;
        margin-top: 4px;
    }

    .btn-primary {
        background-color: var(--accent-primary);
        border: none;
        color: white;
        font-weight: 600;
        padding: 12px 20px;
        margin-top: 10px;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: var(--accent-primary-hover);
        color: white;
    }

    .auth-footer {
        text-align: center;
        margin-top: 20px;
        border-top: 1px solid var(--border-color);
        padding-top: 20px;
    }

    .auth-footer p {
        color: var(--text-secondary);
        margin: 0;
        font-size: 14px;
    }

    .auth-footer a {
        color: var(--accent-primary);
        text-decoration: none;
        font-weight: 600;
    }

    .auth-footer a:hover {
        color: var(--accent-primary-hover);
        text-decoration: underline;
    }

    .alert {
        border-radius: 6px;
        border: 1px solid #e74c3c;
        background-color: rgba(231, 76, 60, 0.1);
        color: #e74c3c;
        margin-bottom: 20px;
    }
</style>
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
