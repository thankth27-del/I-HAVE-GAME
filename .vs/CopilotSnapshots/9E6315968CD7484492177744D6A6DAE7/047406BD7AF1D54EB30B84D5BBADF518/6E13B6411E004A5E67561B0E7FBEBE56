@model List<dynamic>

@{
    ViewData["Title"] = "อันดับคะแนน";
}

<style>
    :root {
        --leaderboard-primary: #007bff;
        --leaderboard-accent: #0056b3;
        --leaderboard-gold: #ffd700;
        --leaderboard-silver: #c0c0c0;
        --leaderboard-bronze: #cd7f32;
        --leaderboard-bg-light: #ffffff;
        --leaderboard-text-light: #212529;
        --leaderboard-border-light: #dee2e6;
    }

    html.dark-mode {
        --leaderboard-primary: #4ba3ff;
        --leaderboard-accent: #357abd;
        --leaderboard-gold: #ffed4e;
        --leaderboard-silver: #d0d0d0;
        --leaderboard-bronze: #e8a76a;
        --leaderboard-bg-light: #2a2a2a;
        --leaderboard-text-light: #e9ecef;
        --leaderboard-border-light: #495057;
    }

    .leaderboard-container {
        background: var(--leaderboard-bg-light);
        color: var(--leaderboard-text-light);
        min-height: calc(100vh - 200px);
        padding: 40px 20px;
    }

    .leaderboard-wrapper {
        max-width: 1000px;
        margin: 0 auto;
    }

    .leaderboard-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 40px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .leaderboard-title {
        font-size: 36px;
        font-weight: 700;
        color: var(--leaderboard-primary);
        margin: 0;
    }

    .leaderboard-back-btn {
        padding: 10px 20px;
        background: var(--leaderboard-primary);
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        font-weight: 600;
        transition: background 0.3s ease;
    }

    .leaderboard-back-btn:hover {
        background: var(--leaderboard-accent);
        color: white;
    }

    .leaderboard-card {
        background: var(--leaderboard-bg-light);
        border: 2px solid var(--leaderboard-primary);
        border-radius: 12px;
        overflow: hidden;
    }

    .leaderboard-table-wrapper {
        overflow-x: auto;
    }

    .leaderboard-table {
        width: 100%;
        border-collapse: collapse;
    }

    .leaderboard-table thead {
        background: rgba(0, 123, 255, 0.1);
        border-bottom: 2px solid var(--leaderboard-primary);
    }

    .leaderboard-table th {
        padding: 15px;
        text-align: left;
        font-weight: 600;
        color: var(--leaderboard-primary);
        text-transform: uppercase;
        font-size: 12px;
    }

    .leaderboard-table td {
        padding: 15px;
        border-bottom: 1px solid var(--leaderboard-border-light);
    }

    .leaderboard-table tbody tr {
        transition: background 0.3s ease;
    }

    .leaderboard-table tbody tr:hover {
        background: rgba(0, 123, 255, 0.05);
    }

    .leaderboard-table tbody tr.current-user {
        background: rgba(0, 123, 255, 0.15);
        font-weight: 600;
        border-left: 4px solid var(--leaderboard-primary);
    }

    .leaderboard-rank {
        font-weight: 700;
        font-size: 18px;
        width: 50px;
        text-align: center;
    }

    .leaderboard-medal {
        font-size: 24px;
        margin-right: 8px;
    }

    .leaderboard-player {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .leaderboard-nickname {
        font-weight: 600;
    }

    .leaderboard-score {
        font-weight: 700;
        color: var(--leaderboard-primary);
        font-size: 18px;
    }

    .leaderboard-attempts {
        text-align: center;
        color: var(--leaderboard-text-light);
    }

    .leaderboard-last-played {
        font-size: 12px;
        color: var(--leaderboard-text-light);
        opacity: 0.7;
    }

    .leaderboard-current-user-section {
        background: var(--leaderboard-bg-light);
        border: 2px solid var(--leaderboard-primary);
        border-radius: 12px;
        padding: 25px;
        margin-top: 30px;
        text-align: center;
    }

    .leaderboard-current-user-section h3 {
        color: var(--leaderboard-primary);
        margin-top: 0;
        font-size: 18px;
    }

    .leaderboard-empty {
        background: var(--leaderboard-bg-light);
        border: 2px dashed var(--leaderboard-border-light);
        border-radius: 12px;
        padding: 60px 40px;
        text-align: center;
    }

    .leaderboard-empty-icon {
        font-size: 80px;
        color: var(--leaderboard-border-light);
        margin-bottom: 20px;
    }

    .leaderboard-empty-text {
        font-size: 18px;
        color: var(--leaderboard-text-light);
        margin-bottom: 20px;
    }

    .leaderboard-empty-btn {
        padding: 12px 30px;
        background: var(--leaderboard-primary);
        color: white;
        border: none;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s ease;
        display: inline-block;
    }

    .leaderboard-empty-btn:hover {
        background: var(--leaderboard-accent);
        color: white;
    }

    .leaderboard-stats {
        background: var(--leaderboard-bg-light);
        border: 2px solid var(--leaderboard-primary);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 30px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 20px;
        text-align: center;
    }

    .leaderboard-stat-item h4 {
        font-size: 12px;
        color: var(--leaderboard-text-light);
        margin: 0 0 10px 0;
        text-transform: uppercase;
        opacity: 0.7;
    }

    .leaderboard-stat-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--leaderboard-primary);
    }

    .badge-top3 {
        display: inline-block;
        padding: 4px 8px;
        background: rgba(0, 123, 255, 0.1);
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        color: var(--leaderboard-primary);
    }

    @@media (max-width: 768px) {
        .leaderboard-table td {
            padding: 10px;
            font-size: 14px;
        }

        .leaderboard-table th {
            font-size: 10px;
        }

        .leaderboard-nickname {
            display: none;
        }

        .leaderboard-score {
            font-size: 16px;
        }
    }
</style>

<style media="(max-width: 576px)">
    .leaderboard-header {
        flex-direction: column;
    }

    .leaderboard-title {
        font-size: 28px;
    }

    .leaderboard-back-btn {
        width: 100%;
    }

    .leaderboard-table th,
    .leaderboard-table td {
        padding: 8px;
        font-size: 12px;
    }

    .leaderboard-table th {
        font-size: 9px;
    }

    .leaderboard-rank {
        font-size: 16px;
        width: 40px;
    }

    .leaderboard-medal {
        font-size: 20px;
        margin-right: 4px;
    }

    .leaderboard-player {
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
    }

    .leaderboard-score {
        font-size: 14px;
    }

    .leaderboard-stats {
        grid-template-columns: 1fr;
    }

    .leaderboard-empty {
        padding: 40px 20px;
    }

    .leaderboard-empty-icon {
        font-size: 60px;
    }

    .leaderboard-empty-text {
        font-size: 16px;
    }
</style>

<div class="leaderboard-container">
    <div class="leaderboard-wrapper">
        <div class="leaderboard-header">
            <h1 class="leaderboard-title">
                <i class="fas fa-trophy"></i> อันดับคะแนนทายชื่อเกม
            </h1>
            <a href="@Url.Action("Index", "Quiz")" class="leaderboard-back-btn">
                <i class="fas fa-arrow-left"></i> กลับไปที่เกม
            </a>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="leaderboard-stats">
                <div class="leaderboard-stat-item">
                    <h4>จำนวนผู้เล่นทั้งหมด</h4>
                    <div class="leaderboard-stat-value">@Model.Count</div>
                </div>
                <div class="leaderboard-stat-item">
                    <h4>คะแนนสูงสุด</h4>
                    <div class="leaderboard-stat-value">@Model[0].TotalScore</div>
                </div>
            </div>

            <div class="leaderboard-card">
                <div class="leaderboard-table-wrapper">
                    <table class="leaderboard-table">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Rank</th>
                                <th>Player</th>
                                <th style="width: 120px;">Total Score</th>
                                <th style="width: 100px;">Attempts</th>
                                <th style="width: 150px;">Last Played</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in Model.Take(10))
                            {
                                var isCurrentUser = (bool)player.IsCurrentUser;
                                var rowClass = isCurrentUser ? "current-user" : "";

                                <tr class="@rowClass">
                                    <td class="leaderboard-rank">
                                        <span class="leaderboard-medal">@player.Medal</span>
                                        @player.Rank
                                    </td>
                                    <td>
                                        <div class="leaderboard-player">
                                            <span class="leaderboard-nickname">@player.Nickname</span>
                                            @if (isCurrentUser)
                                            {
                                                <span style="font-size: 12px; font-weight: 600; color: var(--leaderboard-primary);">
                                                    (You)
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="leaderboard-score">@player.TotalScore</td>
                                    <td class="leaderboard-attempts">@player.AttemptCount</td>
                                    <td class="leaderboard-last-played">
                                        @player.LastPlayed.ToString("MMM dd, yyyy\nHH:mm")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (ViewBag.CurrentUserRank != null && ((int)ViewBag.CurrentUserRank > 10))
            {
                <div class="leaderboard-current-user-section">
                    <h3><i class="fas fa-user-circle"></i> Your Position</h3>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; margin-top: 20px;">
                        <div>
                            <div style="font-size: 12px; color: var(--leaderboard-text-light); opacity: 0.7; text-transform: uppercase;">Rank</div>
                            <div style="font-size: 32px; font-weight: 700; color: var(--leaderboard-primary);">#@ViewBag.CurrentUserRank</div>
                        </div>
                        <div>
                            <div style="font-size: 12px; color: var(--leaderboard-text-light); opacity: 0.7; text-transform: uppercase;">Total Score</div>
                            <div style="font-size: 32px; font-weight: 700; color: var(--leaderboard-primary);">@ViewBag.CurrentUserScore</div>
                        </div>
                        <div>
                            <div style="font-size: 12px; color: var(--leaderboard-text-light); opacity: 0.7; text-transform: uppercase;">Attempts</div>
                            <div style="font-size: 32px; font-weight: 700; color: var(--leaderboard-primary);">@ViewBag.CurrentUserAttempts</div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="leaderboard-empty">
                <div class="leaderboard-empty-icon">
                    <i class="fas fa-inbox"></i>
                </div>
                <div class="leaderboard-empty-text">
                    No quiz attempts yet.
                </div>
                <a href="@Url.Action("Play", "Quiz")" class="leaderboard-empty-btn">
                    <i class="fas fa-play"></i> Play Quiz
                </a>
            </div>
        }
    </div>
</div>
