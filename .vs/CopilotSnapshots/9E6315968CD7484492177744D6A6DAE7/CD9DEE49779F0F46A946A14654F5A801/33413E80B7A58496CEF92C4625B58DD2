@{
    ViewData["Title"] = "หน้าแรก";
}

<div class="container mt-5">
    <div class="row">
        <!-- Welcome Section -->
        <div class="col-lg-8">
            <div class="welcome-card p-5 rounded shadow-sm mb-4">
                <h1 class="display-5 mb-3" style="color: var(--accent-primary);">
                    <i class="fas fa-gamepad"></i> ยินดีต้อนรับสู่ I HAVE GAME
                </h1>
                <p class="lead" style="font-size: 18px;">
                    ค้นหา เปรียบเทียบ และจัดเก็บเกมที่คุณชื่นชอบ
                </p>
                <p class="text-muted">
                    I HAVE GAME เป็นแพลตฟอร์มสำหรับสำรวจและจัดการคอลเลคชั่นเกมของคุณ 
                    ค้นหาเกมใหม่ ได้รับคำแนะนำเกม และติดตามสถิติการเล่นของคุณได้ทั้งหมด
                </p>
                <a href="@Url.Action("Index", "Search")" class="btn btn-primary btn-lg mt-3">
                    <i class="fas fa-search"></i> เริ่มค้นหาเกม
                </a>
            </div>

            <!-- Features Section -->
            <div class="features-section mb-4">
                <h3 class="mb-4" style="color: var(--accent-primary);">
                    <i class="fas fa-star"></i> คุณสมบัติหลัก
                </h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="feature-card p-4 rounded" style="background-color: var(--bg-secondary);">
                            <h5><i class="fas fa-search text-primary"></i> ค้นหาเกม</h5>
                            <p class="text-muted">ค้นหาเกมตามประเภท อุปกรณ์ งบประมาณ และช่วงเวลา</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="feature-card p-4 rounded" style="background-color: var(--bg-secondary);">
                            <h5><i class="fas fa-heart text-primary"></i> คลังเกม</h5>
                            <p class="text-muted">เก็บเกมที่อยากเล่น รอเล่น และเล่นแล้วไว้ในคลัง</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="feature-card p-4 rounded" style="background-color: var(--bg-secondary);">
                            <h5><i class="fas fa-sparkles text-primary"></i> เกมแนะนำ</h5>
                            <p class="text-muted">ได้รับเกมแนะนำที่ตรงกับรสนิยมของคุณ</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="feature-card p-4 rounded" style="background-color: var(--bg-secondary);">
                            <h5><i class="fas fa-gamepad text-primary"></i> ทายชื่อเกม</h5>
                            <p class="text-muted">เล่น Quiz และชิงตำแหน่งในอันดับคะแนน</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Section -->
        <div class="col-lg-4">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- Quick Actions -->
                <div class="quick-actions mb-4">
                    <h5 class="mb-3" style="color: var(--accent-primary);">
                        <i class="fas fa-bolt"></i> ลิงก์ด่วน
                    </h5>
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Index", "Search")" class="btn btn-outline-primary">
                            <i class="fas fa-search"></i> ค้นหาเกม
                        </a>
                        <a href="@Url.Action("Index", "GameLibrary")" class="btn btn-outline-primary">
                            <i class="fas fa-book"></i> คลังเกมของฉัน
                        </a>
                        <a href="@Url.Action("Index", "Recommendations")" class="btn btn-outline-primary">
                            <i class="fas fa-sparkles"></i> เกมแนะนำ
                        </a>
                        <a href="@Url.Action("Index", "Quiz")" class="btn btn-outline-primary">
                            <i class="fas fa-gamepad"></i> ทายชื่อเกม
                        </a>
                    </div>
                </div>
            }
            else
            {
                <!-- Auth Prompt -->
                <div class="auth-card p-4 rounded shadow-sm" style="background-color: var(--bg-secondary); border: 2px solid var(--accent-primary);">
                    <h5 class="mb-3" style="color: var(--accent-primary);">
                        <i class="fas fa-lock"></i> เข้าสู่ระบบเพื่อดำเนินการต่อ
                    </h5>
                    <p class="text-muted mb-3">
                        เข้าสู่ระบบหรือสมัครสมาชิกเพื่อเริ่มจัดการเกมของคุณ
                    </p>
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Login", "Account")" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt"></i> เข้าสู่ระบบ
                        </a>
                        <a href="@Url.Action("Register", "Account")" class="btn btn-outline-primary">
                            <i class="fas fa-user-plus"></i> สมัครสมาชิก
                        </a>
                    </div>
                </div>
            }

            <!-- Info Box -->
            <div class="info-box p-4 rounded mt-4" style="background-color: var(--bg-secondary);">
                <h5 class="mb-3"><i class="fas fa-info-circle"></i> ข้อมูล</h5>
                <small class="text-muted">
                    <p>I HAVE GAME ใช้ข้อมูล RAWG API เพื่อให้คุณได้เกมล่าสุดและข้อมูลเกมที่สมบูรณ์แบบ</p>
                    <p class="mb-0">เริ่มเพลิดเพลินกับการค้นหาเกมของคุณได้เลย!</p>
                </small>
            </div>
        </div>
    </div>
</div>

<style>
    .welcome-card {
        background-color: var(--card-bg);
        border: 1px solid var(--card-border);
        border-left: 4px solid var(--accent-primary);
    }

    .feature-card {
        border-left: 3px solid var(--accent-primary);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 12px var(--shadow-medium);
    }

    .quick-actions .btn {
        text-align: left;
        padding: 12px;
        font-weight: 500;
    }

    .auth-card {
        text-align: center;
    }

    .info-box {
        border-left: 3px solid var(--accent-secondary);
    }
</style>
