<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - I-HAVE-GAME</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/I_HAVE_GAME.styles.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #e0aaff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar {
            background: linear-gradient(90deg, #0f3460 0%, #16213e 100%) !important;
            border-bottom: 2px solid #7b2cbf !important;
            box-shadow: 0 2px 10px rgba(123, 44, 191, 0.3) !important;
            padding: 15px 0 !important;
        }

        .navbar-brand {
            color: #e0aaff !important;
            font-weight: bold;
            font-size: 20px !important;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .navbar-brand:hover {
            color: #c77dff !important;
        }

        .nav-link {
            color: #c77dff !important;
            font-weight: 500;
            margin: 0 10px;
            transition: all 0.3s ease;
        }

        .nav-link:hover {
            color: #e0aaff !important;
        }

        .navbar-toggler {
            border-color: #7b2cbf !important;
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='%23c77dff' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") !important;
        }

        .navbar-expand-sm .navbar-collapse {
            justify-content: flex-end !important;
        }

        .auth-nav {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
            margin-left: auto;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #e0aaff;
            font-size: 14px;
        }

        .user-badge {
            background-color: #7b2cbf;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            color: #f0f0f0;
        }

        .admin-badge {
            background-color: #ff006e;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            color: #f0f0f0;
        }

        .btn-logout {
            background-color: #ff006e;
            border: none;
            color: #f0f0f0;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-logout:hover {
            background-color: #ff3385;
            box-shadow: 0 0 15px rgba(255, 0, 110, 0.5);
        }

        .btn-login,
        .btn-register {
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 13px;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-block;
            border: none;
            cursor: pointer;
        }

        .btn-login {
            background-color: #7b2cbf;
            color: #f0f0f0;
        }

        .btn-login:hover {
            background-color: #c77dff;
            color: #1a1a2e;
        }

        .btn-register {
            background-color: transparent;
            color: #e0aaff;
            border: 1px solid #7b2cbf;
        }

        .btn-register:hover {
            background-color: #7b2cbf;
            color: #f0f0f0;
        }

        .admin-nav-item {
            border-left: 2px solid #ff006e;
            padding-left: 15px;
        }

        footer {
            background: #0f3460 !important;
            border-top: 2px solid #7b2cbf !important;
            color: #7b2cbf !important;
            margin-top: 40px !important;
        }

        footer a {
            color: #c77dff !important;
            text-decoration: none;
        }

        footer a:hover {
            color: #e0aaff !important;
            text-decoration: underline;
        }

        .container {
            background-color: rgba(15, 52, 96, 0.5);
            border-radius: 12px;
            padding: 30px;
            margin-top: 30px;
            border: 1px solid #7b2cbf;
        }
    </style>
    <style>
        @@media (max-width: 576px) {
            .navbar {
                padding: 10px 0 !important;
            }

            .auth-nav {
                width: 100%;
                margin-top: 15px;
                justify-content: center;
            }

            .nav-link {
                margin: 8px 0;
            }

            .container {
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-gamepad"></i> I-HAVE-GAME
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="fas fa-home"></i> Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Search" asp-action="Index">
                                    <i class="fas fa-search"></i> Search New Games
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                                    <i class="fas fa-shield-alt"></i> Privacy
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item admin-nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Index">
                                        <i class="fas fa-cog"></i> Admin Dashboard
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="auth-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="user-info">
                                <i class="fas fa-user-circle"></i>
                                <span>@(User.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name")?.Value ?? "User")</span>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="admin-badge">ADMIN</span>
                                }
                                else
                                {
                                    <span class="user-badge">USER</span>
                                }
                            </div>
                            <form method="post" asp-action="Logout" asp-controller="Account" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-logout">
                                    <i class="fas fa-sign-out-alt"></i> Sign Out
                                </button>
                            </form>
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Account")" class="btn-login">
                                <i class="fas fa-sign-in-alt"></i> Sign In
                            </a>
                            <a href="@Url.Action("Register", "Account")" class="btn-register">
                                <i class="fas fa-user-plus"></i> Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - I-HAVE-GAME - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
