@model GameLibraryViewModel
@using I_HAVE_GAME.ViewModels

@{
    ViewData["Title"] = "My Game Library";
}

<div class="library-container">
    <div class="library-header">
        <h1>🎮 My Game Library</h1>
        <p class="total-games">Total Games: <strong>@Model.TotalGames</strong></p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tab Navigation -->
    <ul class="nav nav-tabs library-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="wishlist-tab" data-bs-toggle="tab" data-bs-target="#wishlist" 
                    type="button" role="tab" aria-controls="wishlist" aria-selected="true">
                <span class="badge">@Model.WishlistGames.Count</span> 🎯 Wishlist
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="backlog-tab" data-bs-toggle="tab" data-bs-target="#backlog" 
                    type="button" role="tab" aria-controls="backlog" aria-selected="false">
                <span class="badge">@Model.BacklogGames.Count</span> 📋 Backlog
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="played-tab" data-bs-toggle="tab" data-bs-target="#played" 
                    type="button" role="tab" aria-controls="played" aria-selected="false">
                <span class="badge">@Model.PlayedGames.Count</span> ✅ Played
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content library-content">
        <!-- Wishlist Tab -->
        <div class="tab-pane fade show active" id="wishlist" role="tabpanel" aria-labelledby="wishlist-tab">
            @if (Model.WishlistGames.Count == 0)
            {
                <div class="empty-state">
                    <h3>No games in your Wishlist yet</h3>
                    <p>Find games you want to play and add them to your Wishlist!</p>
                    <a href="@Url.Action("Index", "Search")" class="btn btn-primary">🔍 Search Games</a>
                </div>
            }
            else
            {
                <div class="games-grid">
                    @foreach (var game in Model.WishlistGames)
                    {
                        <div class="game-card" data-game-id="@game.GameId" data-item-id="@game.Id">
                            @if (!string.IsNullOrWhiteSpace(game.GameImageUrl))
                            {
                                <div class="game-image" style="background-image: url('@game.GameImageUrl');"></div>
                            }
                            else
                            {
                                <div class="game-image no-image">No Image</div>
                            }

                            <div class="game-info">
                                <h3>@game.GameName</h3>
                                <p class="status-badge wishlist">🎯 Wishlist</p>

                                <div class="game-actions">
                                    <button type="button" class="btn btn-sm btn-outline-info status-btn" 
                                            data-item-id="@game.Id" data-current-status="Wishlist" data-new-status="Backlog"
                                            title="Move to Backlog">→ Backlog</button>
                                    <button type="button" class="btn btn-sm btn-outline-success status-btn" 
                                            data-item-id="@game.Id" data-current-status="Wishlist" data-new-status="Played"
                                            title="Mark as Played">✓ Played</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger delete-btn" 
                                            data-item-id="@game.Id"
                                            title="Remove from library">✕ Remove</button>
                                </div>

                                <p class="added-date">Added: @game.AddedAt.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Backlog Tab -->
        <div class="tab-pane fade" id="backlog" role="tabpanel" aria-labelledby="backlog-tab">
            @if (Model.BacklogGames.Count == 0)
            {
                <div class="empty-state">
                    <h3>No games in your Backlog yet</h3>
                    <p>Add games here when you want to play them soon!</p>
                    <a href="@Url.Action("Index", "Search")" class="btn btn-primary">🔍 Search Games</a>
                </div>
            }
            else
            {
                <div class="games-grid">
                    @foreach (var game in Model.BacklogGames)
                    {
                        <div class="game-card" data-game-id="@game.GameId" data-item-id="@game.Id">
                            @if (!string.IsNullOrWhiteSpace(game.GameImageUrl))
                            {
                                <div class="game-image" style="background-image: url('@game.GameImageUrl');"></div>
                            }
                            else
                            {
                                <div class="game-image no-image">No Image</div>
                            }

                            <div class="game-info">
                                <h3>@game.GameName</h3>
                                <p class="status-badge backlog">📋 Backlog</p>

                                <div class="game-actions">
                                    <button type="button" class="btn btn-sm btn-outline-warning status-btn" 
                                            data-item-id="@game.Id" data-current-status="Backlog" data-new-status="Wishlist"
                                            title="Move to Wishlist">→ Wishlist</button>
                                    <button type="button" class="btn btn-sm btn-outline-success status-btn" 
                                            data-item-id="@game.Id" data-current-status="Backlog" data-new-status="Played"
                                            title="Mark as Played">✓ Played</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger delete-btn" 
                                            data-item-id="@game.Id"
                                            title="Remove from library">✕ Remove</button>
                                </div>

                                <p class="added-date">Added: @game.AddedAt.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Played Tab -->
        <div class="tab-pane fade" id="played" role="tabpanel" aria-labelledby="played-tab">
            @if (Model.PlayedGames.Count == 0)
            {
                <div class="empty-state">
                    <h3>No games marked as played yet</h3>
                    <p>Mark games as played when you finish them!</p>
                    <a href="@Url.Action("Index", "Search")" class="btn btn-primary">🔍 Search Games</a>
                </div>
            }
            else
            {
                <div class="games-grid">
                    @foreach (var game in Model.PlayedGames)
                    {
                        <div class="game-card played" data-game-id="@game.GameId" data-item-id="@game.Id">
                            @if (!string.IsNullOrWhiteSpace(game.GameImageUrl))
                            {
                                <div class="game-image" style="background-image: url('@game.GameImageUrl');"></div>
                            }
                            else
                            {
                                <div class="game-image no-image">No Image</div>
                            }

                            <div class="game-info">
                                <h3>@game.GameName</h3>
                                <p class="status-badge played">✅ Played</p>

                                @if (game.Rating.HasValue)
                                {
                                    <div class="rating-display">
                                        <span class="stars">@(new string('★', game.Rating.Value))@(new string('☆', 5 - game.Rating.Value))</span>
                                        <span class="rating-text">@game.Rating/5</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="rating-display">
                                        <span class="stars not-rated">☆☆☆☆☆</span>
                                        <span class="rating-text">Not rated</span>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(game.Review))
                                {
                                    <div class="review-display">
                                        <p class="review-text">@game.Review</p>
                                    </div>
                                }

                                <div class="game-actions">
                                    <button type="button" class="btn btn-sm btn-outline-primary edit-btn" 
                                            data-bs-toggle="modal" data-bs-target="#editModal"
                                            data-item-id="@game.Id" data-game-name="@game.GameName"
                                            data-rating="@(game.Rating ?? 0)" data-review="@game.Review"
                                            title="Edit rating and review">✎ Edit</button>
                                    <button type="button" class="btn btn-sm btn-outline-warning status-btn" 
                                            data-item-id="@game.Id" data-current-status="Played" data-new-status="Backlog"
                                            title="Move to Backlog">→ Backlog</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger delete-btn" 
                                            data-item-id="@game.Id"
                                            title="Remove from library">✕ Remove</button>
                                </div>

                                <p class="added-date">Played on: @game.AddedAt.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit Rating/Review Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-dark">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">✎ Edit Rating & Review</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Game: <span id="editGameName"></span></label>
                </div>

                <div class="mb-3">
                    <label for="ratingInput" class="form-label">Rating (1-5 stars)</label>
                    <div class="rating-input">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <input type="radio" id="star@i" name="ratingInput" value="@i" class="rating-option">
                            <label for="star@i" class="star-label">★</label>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label for="reviewInput" class="form-label">Review/Notes</label>
                    <textarea class="form-control" id="reviewInput" rows="3" placeholder="Share your thoughts about this game..." maxlength="500"></textarea>
                    <small class="text-muted">Max 500 characters</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveEditBtn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<style>
    .library-container {
        background: linear-gradient(135deg, rgba(15, 15, 35, 0.8) 0%, rgba(25, 25, 50, 0.8) 100%);
        border-radius: 12px;
        padding: 2rem;
        margin: 2rem 0;
    }

    .library-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .library-header h1 {
        font-size: 2.5rem;
        font-weight: bold;
        color: #00d4ff;
        text-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
        margin-bottom: 0.5rem;
    }

    .total-games {
        color: #aaa;
        font-size: 1.1rem;
    }

    .total-games strong {
        color: #00d4ff;
        font-weight: bold;
    }

    .library-tabs {
        border-bottom: 2px solid rgba(0, 212, 255, 0.2);
        margin-bottom: 2rem;
    }

    .library-tabs .nav-link {
        color: #888;
        border: none;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        position: relative;
    }

    .library-tabs .nav-link:hover {
        color: #00d4ff;
        background: rgba(0, 212, 255, 0.05);
    }

    .library-tabs .nav-link.active {
        color: #00d4ff;
        border-bottom: 3px solid #00d4ff;
        background: transparent;
    }

    .library-tabs .badge {
        background: rgba(0, 212, 255, 0.2);
        color: #00d4ff;
        margin-right: 0.5rem;
        font-weight: bold;
        border-radius: 12px;
        padding: 0.25rem 0.6rem;
    }

    .library-content {
        min-height: 400px;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: #aaa;
    }

    .empty-state h3 {
        font-size: 1.5rem;
        color: #ccc;
        margin-bottom: 1rem;
    }

    .empty-state p {
        margin-bottom: 1.5rem;
    }

    .games-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .game-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(0, 212, 255, 0.15);
        border-radius: 8px;
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .game-card:hover {
        border-color: #00d4ff;
        box-shadow: 0 0 20px rgba(0, 212, 255, 0.2);
        transform: translateY(-4px);
    }

    .game-image {
        width: 100%;
        height: 180px;
        background-size: cover;
        background-position: center;
        background-color: rgba(0, 0, 0, 0.3);
        position: relative;
    }

    .game-image.no-image {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #666;
        font-size: 0.9rem;
    }

    .game-info {
        padding: 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .game-info h3 {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0 0 0.5rem 0;
        color: #e0e0e0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .status-badge {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1rem;
        width: fit-content;
    }

    .status-badge.wishlist {
        background: rgba(0, 212, 255, 0.2);
        color: #00d4ff;
    }

    .status-badge.backlog {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
    }

    .status-badge.played {
        background: rgba(76, 175, 80, 0.2);
        color: #4caf50;
    }

    .rating-display {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .stars {
        font-size: 1.2rem;
        color: #ffd700;
        letter-spacing: 2px;
    }

    .stars.not-rated {
        color: #666;
    }

    .rating-text {
        font-size: 0.9rem;
        color: #aaa;
    }

    .review-display {
        background: rgba(0, 0, 0, 0.2);
        padding: 0.8rem;
        border-radius: 4px;
        margin-bottom: 0.8rem;
    }

    .review-text {
        font-size: 0.9rem;
        color: #ccc;
        margin: 0;
        line-height: 1.4;
    }

    .game-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: auto;
        margin-bottom: 1rem;
    }

    .game-actions .btn {
        flex: 1;
        min-width: 80px;
        font-size: 0.85rem;
        padding: 0.4rem 0.6rem;
        border-width: 1px;
        transition: all 0.2s ease;
    }

    .game-actions .btn:hover {
        transform: scale(1.05);
    }

    .added-date {
        font-size: 0.85rem;
        color: #777;
        margin: 0;
    }

    /* Modal Styling */
    .modal-dark .modal-content {
        background: rgba(20, 20, 40, 0.95);
        border: 1px solid rgba(0, 212, 255, 0.2);
    }

    .modal-dark .modal-header {
        border-bottom: 1px solid rgba(0, 212, 255, 0.2);
    }

    .modal-dark .modal-body {
        color: #e0e0e0;
    }

    .modal-dark .form-label {
        color: #ccc;
        font-weight: 600;
    }

    .modal-dark .form-control {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(0, 212, 255, 0.2);
        color: #e0e0e0;
    }

    .modal-dark .form-control:focus {
        background: rgba(255, 255, 255, 0.08);
        border-color: #00d4ff;
        box-shadow: 0 0 10px rgba(0, 212, 255, 0.2);
        color: #e0e0e0;
    }

    .rating-input {
        display: flex;
        gap: 1.5rem;
        justify-content: flex-start;
        font-size: 2rem;
    }

    .rating-option {
        display: none;
    }

    .star-label {
        cursor: pointer;
        color: #666;
        transition: all 0.2s ease;
    }

    .rating-option:checked ~ .star-label,
    .star-label:hover {
        color: #ffd700;
        text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
    }

    .text-muted {
        color: #999 !important;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .library-container {
            padding: 1rem;
        }

        .library-header h1 {
            font-size: 1.8rem;
        }

        .games-grid {
            grid-template-columns: 1fr;
        }

        .game-actions .btn {
            min-width: 60px;
            font-size: 0.8rem;
            padding: 0.35rem 0.5rem;
        }

        .library-tabs .nav-link {
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        // Setup edit modal
        const editModal = document.getElementById('editModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const itemId = button.getAttribute('data-item-id');
            const gameName = button.getAttribute('data-game-name');
            const rating = parseInt(button.getAttribute('data-rating')) || 0;
            const review = button.getAttribute('data-review') || '';

            document.getElementById('editGameName').textContent = gameName;
            document.getElementById('reviewInput').value = review;

            // Set rating
            if (rating > 0) {
                document.getElementById('star' + rating).checked = true;
            }

            // Update save button
            document.getElementById('saveEditBtn').dataset.itemId = itemId;
        });

        // Save rating/review changes
        document.getElementById('saveEditBtn').addEventListener('click', async function () {
            const itemId = this.dataset.itemId;
            const rating = parseInt(document.querySelector('input[name="ratingInput"]:checked')?.value) || null;
            const review = document.getElementById('reviewInput').value.trim();

            try {
                const response = await fetch('@Url.Action("EditRatingReview", "GameLibrary")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': csrfToken
                    },
                    body: JSON.stringify({
                        itemId: itemId,
                        rating: rating,
                        review: review
                    })
                });

                const data = await response.json();
                if (data.success) {
                    showNotification(data.message, 'success');
                    bootstrap.Modal.getInstance(editModal).hide();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showNotification(data.message, 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showNotification('Error saving changes', 'error');
            }
        });

        // Change status
        document.querySelectorAll('.status-btn').forEach(button => {
            button.addEventListener('click', async function () {
                const itemId = this.dataset.itemId;
                const newStatus = this.dataset.newStatus;

                try {
                    const response = await fetch('@Url.Action("ChangeStatus", "GameLibrary")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': csrfToken
                        },
                        body: JSON.stringify({
                            itemId: itemId,
                            newStatus: newStatus
                        })
                    });

                    const data = await response.json();
                    if (data.success) {
                        showNotification(data.message, 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showNotification(data.message, 'error');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showNotification('Error updating status', 'error');
                }
            });
        });

        // Delete game
        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', async function () {
                if (!confirm('Are you sure you want to remove this game from your library?')) return;

                const itemId = this.dataset.itemId;

                try {
                    const response = await fetch('@Url.Action("Delete", "GameLibrary")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': csrfToken
                        },
                        body: JSON.stringify({
                            itemId: itemId
                        })
                    });

                    const data = await response.json();
                    if (data.success) {
                        showNotification(data.message, 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showNotification(data.message, 'error');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showNotification('Error removing game', 'error');
                }
            });
        });

        // Show notification
        function showNotification(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            alertDiv.role = 'alert';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;

            const container = document.querySelector('.library-container');
            container.insertBefore(alertDiv, container.firstChild);

            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
        }
    });
</script>
