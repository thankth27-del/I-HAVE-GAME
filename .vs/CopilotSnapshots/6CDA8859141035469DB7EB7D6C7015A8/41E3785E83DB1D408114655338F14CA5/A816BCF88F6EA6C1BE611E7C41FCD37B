        /// <summary>
        /// Map RAWG game to recommendation view model
        /// </summary>
        private RecommendedGameViewModel MapToRecommendedGame(RawgGame game)
        {
            var platformNames = game.Platforms?
                .Where(p => p.Platform != null)
                .Select(p => p.Platform!.Name)
                .Distinct()
                .ToList() ?? new List<string>();

            var genreNames = game.Genres?
                .Select(g => g.Name)
                .ToList() ?? new List<string>();

            return new RecommendedGameViewModel
            {
                GameId = game.Id,
                Name = game.Name,
                Slug = game.Slug,
                ImageUrl = game.BackgroundImage,
                Rating = game.Rating,
                RatingsCount = game.RatingsCount,
                Genres = genreNames,
                Platforms = platformNames,
                ReleaseDate = game.Released
            };
        }

        /// <summary>
        /// Analyze user's library to return preferred genres with weights
        /// </summary>
        public async Task<Dictionary<string, int>> AnalyzePreferencesAsync(int userId, CancellationToken cancellationToken = default)
        {
            var genreWeights = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

            try
            {
                // Get all played games
                var playedGames = await _dbContext.GameLibraryItems
                    .Where(g => g.UserId == userId && g.Status == "Played")
                    .ToListAsync(cancellationToken);

                // For each played game, fetch it from RAWG to get genre info
                foreach (var game in playedGames.OrderByDescending(g => g.Rating))
                {
                    if (game.Rating.HasValue && game.Rating >= 4)
                    {
                        // Weight by rating: 5-star = weight 3, 4-star = weight 1
                        int weight = game.Rating == 5 ? 3 : 1;

                        // In production, you'd fetch genre info from RAWG for each game
                        // For now, we use the slug to infer genres (simplified)
                        var inferredGenres = InferGenresFromTitle(game.GameName);
                        foreach (var genre in inferredGenres)
                        {
                            if (genreWeights.ContainsKey(genre))
                                genreWeights[genre] += weight;
                            else
                                genreWeights[genre] = weight;
                        }
                    }
                }

                // Return top genres by weight
                return genreWeights
                    .OrderByDescending(g => g.Value)
                    .Take(3)
                    .ToDictionary(g => g.Key, g => g.Value);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error analyzing preferences for user {UserId}", userId);
                return new Dictionary<string, int>();
            }
        }

        /// <summary>
        /// Simple genre inference from game title (fallback method)
        /// </summary>
        private List<string> InferGenresFromTitle(string gameName)
        {
            var genres = new List<string>();
            var lowerName = gameName.ToLowerInvariant();

            // Common genre patterns in game titles
            if (lowerName.Contains("action") || lowerName.Contains("combat") || lowerName.Contains("shooter"))
                genres.Add("action");
            if (lowerName.Contains("rpg") || lowerName.Contains("fantasy") || lowerName.Contains("adventure"))
                genres.Add("adventure");
            if (lowerName.Contains("strategy") || lowerName.Contains("tactics") || lowerName.Contains("turn"))
                genres.Add("strategy");
            if (lowerName.Contains("sport") || lowerName.Contains("racing") || lowerName.Contains("fifa"))
                genres.Add("sports");
            if (lowerName.Contains("puzzle") || lowerName.Contains("match"))
                genres.Add("puzzle");
            if (lowerName.Contains("simulation") || lowerName.Contains("sim"))
                genres.Add("simulation");

            // Return at least one default genre
            if (genres.Count == 0)
                genres.Add("action");

            return genres;
        }
    }
}
