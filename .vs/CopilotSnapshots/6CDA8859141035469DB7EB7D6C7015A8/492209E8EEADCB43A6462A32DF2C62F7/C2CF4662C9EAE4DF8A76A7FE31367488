using System.ComponentModel.DataAnnotations;

namespace I_HAVE_GAME.ViewModels
{
    /// <summary>
    /// Main view model for displaying user's game library with tabs
    /// </summary>
    public class GameLibraryViewModel
    {
        public List<GameLibraryItemViewModel> WishlistGames { get; set; } = new List<GameLibraryItemViewModel>();
        public List<GameLibraryItemViewModel> BacklogGames { get; set; } = new List<GameLibraryItemViewModel>();
        public List<GameLibraryItemViewModel> PlayedGames { get; set; } = new List<GameLibraryItemViewModel>();

        public string? SuccessMessage { get; set; }
        public string? ErrorMessage { get; set; }
        public int TotalGames => WishlistGames.Count + BacklogGames.Count + PlayedGames.Count;
    }

    /// <summary>
    /// Individual game item in library
    /// </summary>
    public class GameLibraryItemViewModel
    {
        public int Id { get; set; }
        public int GameId { get; set; }
        public string? GameSlug { get; set; }
        public string GameName { get; set; } = string.Empty;
        public string? GameImageUrl { get; set; }
        public string Status { get; set; } = string.Empty;
        public int? Rating { get; set; }
        public string? Review { get; set; }
        public DateTime AddedAt { get; set; }
    }

    /// <summary>
    /// Request model for adding a game to library
    /// </summary>
    public class AddToLibraryRequest
    {
        public required int GameId { get; set; }
        public string? GameSlug { get; set; }
        public required string GameName { get; set; }
        public string? GameImageUrl { get; set; }
        public required string Status { get; set; } // Wishlist, Backlog, Played
    }

    /// <summary>
    /// Request model for editing a library item (rating/review)
    /// </summary>
    public class EditLibraryItemRequest
    {
        public required int ItemId { get; set; }

        [Range(1, 5, ErrorMessage = "Rating must be between 1 and 5")]
        public int? Rating { get; set; }

        [StringLength(500, ErrorMessage = "Review cannot exceed 500 characters")]
        public string? Review { get; set; }
    }

    /// <summary>
    /// Request model for changing status
    /// </summary>
    public class ChangeStatusRequest
    {
        public required int ItemId { get; set; }
        public required string NewStatus { get; set; } // Wishlist, Backlog, Played
    }

    /// <summary>
    /// Request model for deleting an item
    /// </summary>
    public class DeleteLibraryItemRequest
    {
        public required int ItemId { get; set; }
    }
}
