using I_HAVE_GAME.Data;
using I_HAVE_GAME.Models;
using I_HAVE_GAME.ViewModels;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using System.Security.Claims;

namespace I_HAVE_GAME.Controllers
{
    [Authorize]
    public class GameLibraryController : Controller
    {
        private readonly AppDbContext _dbContext;
        private readonly ILogger<GameLibraryController> _logger;

        public GameLibraryController(AppDbContext dbContext, ILogger<GameLibraryController> logger)
        {
            _dbContext = dbContext;
            _logger = logger;
        }

        /// <summary>
        /// Get the current user's ID from claims
        /// </summary>
        private int GetCurrentUserId()
        {
            var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier);
            if (!int.TryParse(userIdClaim?.Value, out var userId))
            {
                throw new UnauthorizedAccessException("User ID not found in claims");
            }
            return userId;
        }

        /// <summary>
        /// Display user's game library with 3 tabs
        /// </summary>
        public async Task<IActionResult> Index()
        {
            try
            {
                var userId = GetCurrentUserId();
                var userLibrary = await _dbContext.GameLibraryItems
                    .Where(g => g.UserId == userId)
                    .OrderByDescending(g => g.AddedAt)
                    .ToListAsync();

                var viewModel = new GameLibraryViewModel
                {
                    WishlistGames = userLibrary
                        .Where(g => g.Status == "Wishlist")
                        .Select(MapToViewModel)
                        .ToList(),
                    BacklogGames = userLibrary
                        .Where(g => g.Status == "Backlog")
                        .Select(MapToViewModel)
                        .ToList(),
                    PlayedGames = userLibrary
                        .Where(g => g.Status == "Played")
                        .OrderByDescending(g => g.Rating)
                        .Select(MapToViewModel)
                        .ToList()
                };

                return View(viewModel);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error loading game library");
                return View("Error", new ErrorViewModel { Message = "Error loading your library" });
            }
        }

        /// <summary>
        /// Add a game to library with duplicate prevention
        /// </summary>
        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> AddToLibrary([FromBody] AddToLibraryRequest request)
        {
            if (!ModelState.IsValid)
            {
                return Json(new { success = false, message = "Invalid request data" });
            }

            try
            {
                var userId = GetCurrentUserId();

                // Check for existing game in library
                var existingGame = await _dbContext.GameLibraryItems
                    .FirstOrDefaultAsync(g => g.UserId == userId && g.GameId == request.GameId);

                if (existingGame != null)
                {
                    return Json(new 
                    { 
                        success = false, 
                        message = $"This game is already in your library ({existingGame.Status}). Would you like to change its status instead?" 
                    });
                }

                // Validate status
                if (!IsValidStatus(request.Status))
                {
                    return Json(new { success = false, message = "Invalid status. Use: Wishlist, Backlog, or Played" });
                }

                // Create new library item
                var libraryItem = new GameLibraryItem
                {
                    UserId = userId,
                    GameId = request.GameId,
                    GameSlug = request.GameSlug,
                    GameName = request.GameName,
                    GameImageUrl = request.GameImageUrl,
                    Status = request.Status,
                    Genre = request.Genre, // Store genre data from request
                    AddedAt = DateTime.UtcNow
                };

                _dbContext.GameLibraryItems.Add(libraryItem);
                await _dbContext.SaveChangesAsync();

                return Json(new 
                { 
                    success = true, 
                    message = $"✓ Added '{request.GameName}' to your {request.Status}!",
                    itemId = libraryItem.Id
                });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error adding game to library");
                return Json(new { success = false, message = "Error adding game to library. Please try again." });
            }
        }

        /// <summary>
        /// Change the status of a library item
        /// </summary>
        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> ChangeStatus([FromBody] ChangeStatusRequest request)
        {
            if (!ModelState.IsValid)
            {
                return Json(new { success = false, message = "Invalid request data" });
            }

            try
            {
                var userId = GetCurrentUserId();

                var libraryItem = await _dbContext.GameLibraryItems
                    .FirstOrDefaultAsync(g => g.Id == request.ItemId && g.UserId == userId);

                if (libraryItem == null)
                {
                    return Json(new { success = false, message = "Game not found in your library" });
                }

                if (!IsValidStatus(request.NewStatus))
                {
                    return Json(new { success = false, message = "Invalid status. Use: Wishlist, Backlog, or Played" });
                }

                var oldStatus = libraryItem.Status;
                libraryItem.Status = request.NewStatus;

                // Clear rating/review if moving away from Played
                if (oldStatus == "Played" && request.NewStatus != "Played")
                {
                    libraryItem.Rating = null;
                    libraryItem.Review = null;
                }

                await _dbContext.SaveChangesAsync();

                return Json(new 
                { 
                    success = true, 
                    message = $"✓ Moved '{libraryItem.GameName}' from {oldStatus} to {request.NewStatus}" 
                });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error changing game status");
                return Json(new { success = false, message = "Error updating game status. Please try again." });
            }
        }

        /// <summary>
        /// Edit rating and review for a played game
        /// </summary>
        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> EditRatingReview([FromBody] EditLibraryItemRequest request)
        {
            if (!ModelState.IsValid)
            {
                return Json(new { success = false, message = "Invalid request data" });
            }

            try
            {
                var userId = GetCurrentUserId();

                var libraryItem = await _dbContext.GameLibraryItems
                    .FirstOrDefaultAsync(g => g.Id == request.ItemId && g.UserId == userId);

                if (libraryItem == null)
                {
                    return Json(new { success = false, message = "Game not found in your library" });
                }

                if (libraryItem.Status != "Played")
                {
                    return Json(new { success = false, message = "Only played games can have ratings and reviews" });
                }

                libraryItem.Rating = request.Rating;
                libraryItem.Review = request.Review;

                await _dbContext.SaveChangesAsync();

                var starDisplay = request.Rating.HasValue ? new string('★', request.Rating.Value) : "Not rated";
                return Json(new 
                { 
                    success = true, 
                    message = $"✓ Updated '{libraryItem.GameName}' with rating and review" 
                });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error updating rating and review");
                return Json(new { success = false, message = "Error updating game rating/review. Please try again." });
            }
        }

        /// <summary>
        /// Delete a game from library
        /// </summary>
        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> Delete([FromBody] DeleteLibraryItemRequest request)
        {
            if (!ModelState.IsValid)
            {
                return Json(new { success = false, message = "Invalid request data" });
            }

            try
            {
                var userId = GetCurrentUserId();

                var libraryItem = await _dbContext.GameLibraryItems
                    .FirstOrDefaultAsync(g => g.Id == request.ItemId && g.UserId == userId);

                if (libraryItem == null)
                {
                    return Json(new { success = false, message = "Game not found in your library" });
                }

                var gameName = libraryItem.GameName;
                _dbContext.GameLibraryItems.Remove(libraryItem);
                await _dbContext.SaveChangesAsync();

                return Json(new 
                { 
                    success = true, 
                    message = $"✓ Removed '{gameName}' from your library" 
                });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error deleting library item");
                return Json(new { success = false, message = "Error removing game from library. Please try again." });
            }
        }

        /// <summary>
        /// Helper method to validate status
        /// </summary>
        private bool IsValidStatus(string status)
        {
            return status is "Wishlist" or "Backlog" or "Played";
        }

        /// <summary>
        /// Map GameLibraryItem to ViewModel
        /// </summary>
        private GameLibraryItemViewModel MapToViewModel(GameLibraryItem item)
        {
            return new GameLibraryItemViewModel
            {
                Id = item.Id,
                GameId = item.GameId,
                GameSlug = item.GameSlug,
                GameName = item.GameName,
                GameImageUrl = item.GameImageUrl,
                Status = item.Status,
                Rating = item.Rating,
                Review = item.Review,
                Genre = item.Genre,
                AddedAt = item.AddedAt
            };
        }
    }
}
