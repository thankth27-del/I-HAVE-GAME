@model I_HAVE_GAME.ViewModels.QuizResultViewModel

@{
    ViewData["Title"] = "Quiz Result";
    var percentage = (Model.Score * 100) / Model.TotalQuestions;
    var resultMessage = Model.Score == Model.TotalQuestions ? "Perfect Score! 🌟" :
                        Model.Score >= 4 ? "Excellent! 🎉" :
                        Model.Score >= 3 ? "Good Job! 👍" :
                        Model.Score >= 2 ? "Not Bad! 😊" :
                        "Keep Trying! 💪";
}
<style>
    :root {
        --quiz-primary: #007bff;
        --quiz-accent: #0056b3;
        --quiz-success: #28a745;
        --quiz-warning: #ffc107;
        --quiz-danger: #dc3545;
        --quiz-bg-light: #ffffff;
        --quiz-text-light: #212529;
        --quiz-border-light: #dee2e6;
    }

    html.dark-mode {
        --quiz-primary: #4ba3ff;
        --quiz-accent: #357abd;
        --quiz-success: #51cf66;
        --quiz-warning: #ffd43b;
        --quiz-danger: #ff6b6b;
        --quiz-bg-light: #2a2a2a;
        --quiz-text-light: #e9ecef;
        --quiz-border-light: #495057;
    }

    .quiz-container {
        background: var(--quiz-bg-light);
        color: var(--quiz-text-light);
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .quiz-result-card {
        background: var(--quiz-bg-light);
        border: 2px solid var(--quiz-primary);
        border-radius: 12px;
        padding: 50px 40px;
        max-width: 600px;
        width: 100%;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .result-icon {
        font-size: 80px;
        margin-bottom: 20px;
    }

    .result-icon.perfect {
        color: #ffd700;
    }

    .result-icon.excellent {
        color: var(--quiz-success);
    }

    .result-icon.good {
        color: var(--quiz-warning);
    }

    .result-icon.trying {
        color: var(--quiz-danger);
    }

    .result-message {
        font-size: 32px;
        font-weight: 700;
        color: var(--quiz-text-light);
        margin-bottom: 10px;
    }

    .result-score {
        font-size: 64px;
        font-weight: 700;
        color: var(--quiz-primary);
        margin: 20px 0;
    }

    .result-score-text {
        font-size: 18px;
        color: var(--quiz-text-light);
        margin-bottom: 30px;
    }

    .result-percent-bar {
        width: 100%;
        height: 12px;
        background: var(--quiz-border-light);
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .result-percent-fill {
        height: 100%;
        transition: width 0.5s ease;
        width: 60%;
        background: var(--quiz-danger);
    }

    .result-percent-fill.perfect {
        background: #ffd700;
        width: 100%;
    }

    .result-percent-fill.excellent {
        background: var(--quiz-success);
        width: 80%;
    }

    .result-percent-fill.good {
        background: var(--quiz-warning);
        width: 60%;
    }

    .result-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .result-btn {
        flex: 1;
        padding: 12px 20px;
        font-size: 16px;
        font-weight: 600;
        border: 2px solid var(--quiz-primary);
        background: var(--quiz-bg-light);
        color: var(--quiz-primary);
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .result-btn:hover {
        background: var(--quiz-primary);
        color: white;
        text-decoration: none;
    }

    .result-btn-primary {
        background: var(--quiz-primary);
        color: white;
        border-color: var(--quiz-primary);
    }

    .result-btn-primary:hover {
        background: var(--quiz-accent);
        border-color: var(--quiz-accent);
    }

    .result-info {
        background: rgba(0, 123, 255, 0.1);
        border-left: 4px solid var(--quiz-primary);
        padding: 15px;
        margin: 20px 0;
        border-radius: 6px;
        font-size: 14px;
    }

    @@media (max-width: 576px) {
        .quiz-result-card {
            padding: 30px 20px;
        }

        .result-icon {
            font-size: 60px;
        }

        .result-message {
            font-size: 24px;
        }

        .result-score {
            font-size: 48px;
        }

        .result-actions {
            flex-direction: column;
        }

        .result-btn {
            width: 100%;
        }
    }
</style>

<div class="quiz-container">
    <div class="quiz-result-card">
        <div class="result-icon @(Model.Score == Model.TotalQuestions ? "perfect" : Model.Score >= 4 ? "excellent" : Model.Score >= 3 ? "good" : "trying")">
            @if (Model.Score == Model.TotalQuestions)
            {
                <i class="fas fa-star"></i>
            }
            else if (Model.Score >= 4)
            {
                <i class="fas fa-grin-stars"></i>
            }
            else if (Model.Score >= 3)
            {
                <i class="fas fa-thumbs-up"></i>
            }
            else
            {
                <i class="fas fa-smile"></i>
            }
        </div>

        <div class="result-message">@resultMessage</div>

        <div class="result-score">@Model.Score/@Model.TotalQuestions</div>

        <div class="result-score-text">
            @if (Model.Score == Model.TotalQuestions)
            {
                <text>You answered all questions correctly!</text>
            }
            else
            {
                <text>You got @Model.Score out of @Model.TotalQuestions questions right.</text>
            }
        </div>

        <div class="result-percent-bar">
            <div class="result-percent-fill @(Model.Score == Model.TotalQuestions ? "perfect" : Model.Score >= 4 ? "excellent" : Model.Score >= 3 ? "good" : "")"></div>
        </div>

        @if (Model.AttemptRecorded)
        {
            <div class="result-info">
                <i class="fas fa-check-circle"></i> Your score has been saved to your quiz history!
            </div>
        }

        <div class="result-actions">
            <form method="post" asp-action="Reset" style="flex: 1;">
                @Html.AntiForgeryToken()
                <button type="submit" class="result-btn result-btn-primary" style="width: 100%;">
                    <i class="fas fa-redo"></i> Play Again
                </button>
            </form>
            <a href="@Url.Action("Index", "Quiz")" class="result-btn">
                <i class="fas fa-home"></i> Quiz Home
            </a>
        </div>

        <div style="margin-top: 20px;">
            <a href="@Url.Action("History", "Quiz")" class="result-btn" style="width: 100%;">
                <i class="fas fa-history"></i> View My History
            </a>
        </div>
    </div>
</div>
