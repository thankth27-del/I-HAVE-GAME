/* Theme Color Variables - Dark Gaming Theme */
:root {
  /* Gaming Dark Mode Colors - Default */
  --bg-primary: #0a0e27;
  --bg-secondary: #16213e;
  --bg-tertiary: #1d2d5f;
  --text-primary: #e0e6ff;
  --text-secondary: #a8b5d1;
  --text-tertiary: #7a8399;
  --accent-primary: #00d4ff;
  --accent-primary-hover: #00ffff;
  --accent-secondary: #b740d4;
  --accent-tertiary: #ff006e;
  --accent-neon: #39ff14;
  --border-color: #2a3f60;
  --card-bg: #141b34;
  --card-border: #2a3f60;
  --shadow-light: rgba(0, 212, 255, 0.1);
  --shadow-medium: rgba(0, 212, 255, 0.2);
  --shadow-glow: 0 0 20px rgba(0, 212, 255, 0.3);
}

html.dark-mode {
  /* Dark Mode Colors */
  --bg-primary: #0a0e27;
  --bg-secondary: #16213e;
  --bg-tertiary: #1d2d5f;
  --text-primary: #e0e6ff;
  --text-secondary: #a8b5d1;
  --text-tertiary: #7a8399;
  --accent-primary: #00d4ff;
  --accent-primary-hover: #00ffff;
  --accent-secondary: #b740d4;
  --accent-tertiary: #ff006e;
  --accent-neon: #39ff14;
  --border-color: #2a3f60;
  --card-bg: #141b34;
  --card-border: #2a3f60;
  --shadow-light: rgba(0, 212, 255, 0.1);
  --shadow-medium: rgba(0, 212, 255, 0.2);
  --shadow-glow: 0 0 20px rgba(0, 212, 255, 0.3);
}

html {
  font-size: 14px;
  position: relative;
  min-height: 100%;
}

@media (min-width: 768px) {
  html {
    font-size: 16px;
  }
}

body {
  margin-bottom: 60px;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.btn:focus, .btn:active:focus, .btn-link.nav-link:focus, .form-control:focus, .form-check-input:focus {
  box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem var(--accent-primary);
}

/* Button Styling */
.btn-primary {
  background-color: var(--accent-primary);
  border-color: var(--accent-primary);
  color: white;
}

.btn-primary:hover {
  background-color: var(--accent-primary-hover);
  border-color: var(--accent-primary-hover);
}

.btn-primary:focus {
  background-color: var(--accent-primary-hover);
  border-color: var(--accent-primary-hover);
}

.btn-outline-primary {
  color: var(--accent-primary);
  border-color: var(--accent-primary);
}

.btn-outline-primary:hover {
  background-color: var(--accent-primary);
  border-color: var(--accent-primary);
  color: white;
}

.btn-outline-success {
  color: #4caf50;
  border-color: #4caf50;
}

.btn-outline-success:hover {
  background-color: #4caf50;
  border-color: #4caf50;
  color: white;
}

.btn-outline-danger {
  color: #e74c3c;
  border-color: #e74c3c;
}

.btn-outline-danger:hover {
  background-color: #e74c3c;
  border-color: #e74c3c;
  color: white;
}

.btn-outline-info {
  color: var(--accent-primary);
  border-color: var(--accent-primary);
}

.btn-outline-info:hover {
  background-color: var(--accent-primary);
  border-color: var(--accent-primary);
  color: white;
}

/* Form Styling */
.form-control {
  background-color: var(--bg-secondary);
  border-color: var(--border-color);
  color: var(--text-primary);
}

.form-control:focus {
  background-color: var(--bg-secondary);
  border-color: var(--accent-primary);
  color: var(--text-primary);
}

.form-label {
  color: var(--text-primary);
}

.table {
  color: var(--text-primary);
}

.table-striped > tbody > tr:nth-of-type(odd) {
  background-color: var(--bg-secondary);
}

.alert {
  border-color: var(--border-color);
}

.alert-success {
  background-color: rgba(76, 175, 80, 0.1);
  border-color: #4caf50;
  color: #4caf50;
}

.alert-danger {
  background-color: rgba(231, 76, 60, 0.1);
  border-color: #e74c3c;
  color: #e74c3c;
}

/* Card Styling */
.card {
  background: linear-gradient(135deg, var(--card-bg) 0%, rgba(29, 45, 95, 0.5) 100%);
  border: 1px solid var(--card-border);
  border-radius: 12px;
  box-shadow: var(--shadow-glow), inset 0 1px 0 rgba(0, 212, 255, 0.1);
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.1), transparent);
  transition: left 0.5s;
  pointer-events: none;
}

.card:hover {
  box-shadow: var(--shadow-glow), 0 0 30px rgba(183, 64, 212, 0.3), inset 0 1px 0 rgba(0, 212, 255, 0.2);
  transform: translateY(-4px);
  border-color: var(--accent-primary);
}

.card:hover::before {
  left: 100%;
}

.card-header {
  background: linear-gradient(90deg, var(--bg-secondary), rgba(29, 45, 95, 0.5));
  border-bottom: 2px solid var(--accent-primary);
  color: var(--text-primary);
  font-weight: 600;
  text-shadow: 0 0 10px rgba(0, 212, 255, 0.3);
}

.card-title {
  color: var(--accent-primary);
  font-weight: 700;
  text-shadow: 0 0 10px rgba(0, 212, 255, 0.2);
}

.card-text {
  color: var(--text-secondary);
}

/* Badge Styling */
.badge {
  font-size: 12px;
  padding: 6px 12px;
  border-radius: 20px;
  font-weight: 600;
}

.badge-primary {
  background-color: var(--accent-primary);
  color: white;
}

.badge-secondary {
  background-color: var(--bg-tertiary);
  color: var(--text-primary);
}

.badge-success {
  background-color: #4caf50;
  color: white;
}

.badge-danger {
  background-color: #e74c3c;
  color: white;
}

.badge-warning {
  background-color: #f39c12;
  color: white;
}

.badge-info {
  background-color: var(--accent-secondary);
  color: white;
}

/* Form Elements */
.form-control, .form-select {
  background-color: var(--bg-secondary);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  border-radius: 6px;
  transition: all 0.3s ease;
  padding: 10px 12px;
}

.form-control:focus, .form-select:focus {
  background-color: var(--bg-primary);
  border-color: var(--accent-primary);
  color: var(--text-primary);
  box-shadow: 0 0 0 0.2rem rgba(0, 102, 204, 0.15);
}

.form-control::placeholder {
  color: var(--text-tertiary);
  opacity: 0.7;
}

.form-label {
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 8px;
}

.input-group-text {
  background-color: var(--bg-secondary);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
}

/* Table Styling */
.table {
  color: var(--text-primary);
  background-color: var(--card-bg);
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 8px;
  overflow: hidden;
}

.table thead th {
  background-color: var(--bg-secondary);
  border-bottom: 2px solid var(--border-color);
  color: var(--text-primary);
  font-weight: 700;
  padding: 12px;
}

.table tbody td {
  padding: 12px;
  border-bottom: 1px solid var(--border-color);
  vertical-align: middle;
}

.table tbody tr:hover {
  background-color: var(--bg-secondary);
  transition: background-color 0.2s ease;
}

.table tbody tr:last-child td {
  border-bottom: none;
}

/* Alert Styling */
.alert {
  border-radius: 8px;
  border: 1px solid;
  padding: 15px 20px;
  animation: slideDown 0.3s ease;
}

.alert-success {
  background-color: rgba(76, 175, 80, 0.1);
  border-color: #4caf50;
  color: #2e7d32;
}

.alert-danger {
  background-color: rgba(231, 76, 60, 0.1);
  border-color: #e74c3c;
  color: #c0392b;
}

.alert-warning {
  background-color: rgba(243, 156, 18, 0.1);
  border-color: #f39c12;
  color: #d68910;
}

.alert-info {
  background-color: rgba(52, 152, 219, 0.1);
  border-color: #3498db;
  color: #2980b9;
}

/* Button Enhancements */
.btn {
  font-weight: 600;
  padding: 10px 20px;
  border-radius: 6px;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.1);
  transition: left 0.4s;
  z-index: 0;
}

.btn > * {
  position: relative;
  z-index: 1;
}

.btn-lg {
  padding: 14px 28px;
  font-size: 16px;
}

.btn-sm {
  padding: 6px 12px;
  font-size: 12px;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
  color: #0a0e27;
  font-weight: 700;
  box-shadow: 0 0 15px rgba(0, 212, 255, 0.4);
}

.btn-primary:hover {
  background: linear-gradient(135deg, var(--accent-primary-hover) 0%, #9500c4 100%);
  box-shadow: 0 0 25px rgba(0, 212, 255, 0.6), 0 0 40px rgba(183, 64, 212, 0.4);
  transform: translateY(-2px);
}

.btn-outline-primary {
  color: var(--accent-primary);
  border: 2px solid var(--accent-primary);
  background-color: transparent;
  box-shadow: inset 0 0 10px rgba(0, 212, 255, 0.2);
}

.btn-outline-primary:hover {
  background-color: var(--accent-primary);
  color: #0a0e27;
  box-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
}

.btn-secondary {
  background-color: var(--bg-secondary);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
}

.btn-secondary:hover {
  background-color: var(--bg-tertiary);
  border-color: var(--accent-primary);
  box-shadow: 0 0 15px rgba(0, 212, 255, 0.3);
}

/* Page Section Styling */
.page-header {
  padding: 20px 0 30px;
  border-bottom: 3px solid transparent;
  border-image: linear-gradient(90deg, var(--accent-primary) 0%, var(--accent-secondary) 100%) 1;
  margin-bottom: 30px;
  position: relative;
}

.page-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--accent-primary), var(--accent-secondary), transparent);
  filter: drop-shadow(0 0 8px var(--accent-primary));
}

.page-header h1 {
  color: var(--accent-primary);
  font-weight: 700;
  font-size: 36px;
  margin-bottom: 10px;
  text-shadow: 0 0 15px rgba(0, 212, 255, 0.3);
}

.page-header p {
  color: var(--text-secondary);
  margin: 0;
}

.section-title {
  color: var(--accent-primary);
  font-weight: 700;
  font-size: 24px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  text-shadow: 0 0 10px rgba(0, 212, 255, 0.2);
}

.section-title i {
  font-size: 28px;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    text-shadow: 0 0 10px var(--accent-primary);
  }
  50% {
    text-shadow: 0 0 20px var(--accent-secondary);
  }
}

/* Panel/Container Styling */
.panel {
  background: linear-gradient(135deg, var(--card-bg) 0%, rgba(29, 45, 95, 0.5) 100%);
  border: 1px solid var(--card-border);
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: var(--shadow-glow), inset 0 1px 0 rgba(0, 212, 255, 0.1);
}

.panel-header {
  border-bottom: 2px solid var(--accent-primary);
  padding-bottom: 15px;
  margin-bottom: 15px;
  color: var(--accent-primary);
  font-weight: 700;
}

/* Grid & Spacing Utilities */
.gap-sm { gap: 12px; }
.gap-md { gap: 20px; }
.gap-lg { gap: 30px; }

.p-2 { padding: 12px; }
.p-3 { padding: 20px; }
.p-4 { padding: 30px; }

.mb-xs { margin-bottom: 6px; }
.mb-sm { margin-bottom: 12px; }
.mb-md { margin-bottom: 20px; }
.mb-lg { margin-bottom: 30px; }

.mt-xs { margin-top: 6px; }
.mt-sm { margin-top: 12px; }
.mt-md { margin-top: 20px; }
.mt-lg { margin-top: 30px; }

/* Animations */
@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

.fade-in {
  animation: fadeIn 0.3s ease;
}

.pulse {
  animation: pulse 2s infinite;
}

/* Link Styling */
a {
  color: var(--accent-primary);
  text-decoration: none;
  transition: all 0.3s ease;
}

a:hover {
  color: var(--accent-primary-hover);
  text-decoration: underline;
}

/* Text Utilities */
.text-primary {
  color: var(--text-primary) !important;
}

.text-secondary {
  color: var(--text-secondary) !important;
}

.text-tertiary {
  color: var(--text-tertiary) !important;
}

.text-accent {
  color: var(--accent-primary) !important;
}

.fw-700 {
  font-weight: 700;
}

.fw-600 {
  font-weight: 600;
}

.fw-500 {
  font-weight: 500;
}

/* Border Radius */
.rounded-sm {
  border-radius: 4px;
}

.rounded-md {
  border-radius: 8px;
}

.rounded-lg {
  border-radius: 12px;
}

/* Shadow Utilities */
.shadow-sm {
  box-shadow: 0 2px 8px var(--shadow-light) !important;
}

.shadow-md {
  box-shadow: 0 4px 12px var(--shadow-medium) !important;
}

.shadow-lg {
  box-shadow: 0 8px 20px var(--shadow-medium) !important;
}

/* Responsive */
@media (max-width: 768px) {
  .page-header h1 {
    font-size: 28px;
  }

  .section-title {
    font-size: 20px;
  }

  .card {
    margin-bottom: 15px;
  }

  .btn-lg {
    padding: 12px 20px;
    font-size: 14px;
  }
}
}