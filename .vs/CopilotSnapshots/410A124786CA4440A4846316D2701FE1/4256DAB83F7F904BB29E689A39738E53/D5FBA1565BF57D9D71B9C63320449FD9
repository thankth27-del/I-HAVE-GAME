@page
@model I_HAVE_GAME.Pages.SearchModel
@{
    ViewData["Title"] = "Search Games";
}

<div class="container-fluid mt-4 mb-5">
    <!-- Page Header -->
    <div class="page-header mb-5">
        <h1 class="display-4 mb-3" style="color: var(--accent-primary); font-weight: 700;">
            <i class="fas fa-search"></i> ค้นหาเกม
        </h1>
        <p class="lead text-muted">
            ค้นหาเกมที่ชอบของคุณจากห้องสมุดเกมที่มีขนาดใหญ่
        </p>
    </div>

    <!-- Search Form Card -->
    <div class="card shadow-sm mb-5" style="background-color: var(--bg-secondary); border: none;">
        <div class="card-body p-4">
            <form method="get" class="search-form">
                <div class="row g-3">
                    <!-- Main Search Input -->
                    <div class="col-lg-4">
                        <label class="form-label fw-500 mb-2">
                            <i class="fas fa-search" style="color: var(--accent-primary);"></i> ค้นหา
                        </label>
                        <input 
                            class="form-control form-control-lg" 
                            type="text" 
                            name="q" 
                            value="@Model.q" 
                            placeholder="ค้นหาชื่อ, แท็ก, หรือคำอธิบาย..." 
                            style="border-color: var(--border-color);"
                        />
                        <small class="form-text text-muted">ค้นหาจากชื่อเกม แท็ก หรือคำอธิบาย</small>
                    </div>

                    <!-- Genre Filter -->
                    <div class="col-md-6 col-lg-2">
                        <label class="form-label fw-500 mb-2">
                            <i class="fas fa-tag" style="color: var(--accent-primary);"></i> ประเภท
                        </label>
                        <input 
                            class="form-control form-control-lg" 
                            type="text" 
                            name="genre" 
                            value="@Model.genre" 
                            placeholder="เช่น Action, RPG..." 
                            style="border-color: var(--border-color);"
                        />
                    </div>

                    <!-- Platform Filter -->
                    <div class="col-md-6 col-lg-2">
                        <label class="form-label fw-500 mb-2">
                            <i class="fas fa-gamepad" style="color: var(--accent-primary);"></i> แพลตฟอร์ม
                        </label>
                        <input 
                            class="form-control form-control-lg" 
                            type="text" 
                            name="platform" 
                            value="@Model.platform" 
                            placeholder="เช่น PC, PS5..." 
                            style="border-color: var(--border-color);"
                        />
                    </div>

                    <!-- Rating Filter -->
                    <div class="col-md-6 col-lg-2">
                        <label class="form-label fw-500 mb-2">
                            <i class="fas fa-star" style="color: var(--accent-primary);"></i> คะแนน
                        </label>
                        <input 
                            class="form-control form-control-lg" 
                            type="number" 
                            step="0.1" 
                            min="0" 
                            max="5"
                            name="minRating" 
                            value="@(Model.minRating?.ToString() ?? string.Empty)" 
                            placeholder="ตั้งแต่..." 
                            style="border-color: var(--border-color);"
                        />
                    </div>

                    <!-- Search Button -->
                    <div class="col-md-6 col-lg-2 d-flex align-items-end">
                        <button class="btn btn-primary btn-lg w-100" type="submit" style="font-weight: 600; letter-spacing: 0.5px;">
                            <i class="fas fa-search"></i> ค้นหา
                        </button>
                    </div>
                </div>

                <!-- Quick Filters (Optional) -->
                <div class="mt-4 pt-3 border-top">
                    <small class="text-muted d-block mb-2">หรือลองค้นหาด้วย:</small>
                    <div class="btn-group flex-wrap" role="group">
                        <a href="?genre=Action" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-bolt"></i> Action
                        </a>
                        <a href="?genre=RPG" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-sword"></i> RPG
                        </a>
                        <a href="?genre=Indie" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-heart"></i> Indie
                        </a>
                        <a href="?genre=Puzzle" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-cube"></i> Puzzle
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Section -->
    @if (Model.Results?.Any() == true)
    {
        <div class="results-section">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 style="color: var(--text-primary); font-weight: 700;">
                    <i class="fas fa-list-ul"></i> ผลลัพธ์ (@Model.Results.Count() เกม)
                </h4>
            </div>

            <div class="row g-3">
                @foreach (var g in Model.Results)
                {
                    <div class="col-lg-6">
                        <a href="#" class="game-card card shadow-sm h-100" style="border: none; background-color: var(--card-bg); cursor: pointer; transition: all 0.3s ease; text-decoration: none; overflow: hidden;">
                            <div class="card-body d-flex p-0">
                                <!-- Game Image -->
                                <div class="game-image position-relative" style="width: 140px; flex-shrink: 0; overflow: hidden;">
                                    <img 
                                        src="@(string.IsNullOrWhiteSpace(g.ImageUrl) ? "/images/placeholder.png" : g.ImageUrl)" 
                                        alt="@g.Title" 
                                        class="h-100" 
                                        style="width: 100%; object-fit: cover; transition: transform 0.3s ease;"
                                    />
                                    <div class="position-absolute top-0 end-0 m-2" style="background: var(--accent-primary); color: white; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 12px;">
                                        ⭐ @(g.Rating?.ToString("0.0") ?? "—")
                                    </div>
                                </div>

                                <!-- Game Info -->
                                <div class="p-4 flex-grow-1 d-flex flex-column" style="color: var(--text-primary);">
                                    <div class="mb-2">
                                        <h6 class="fw-700 mb-1" style="font-size: 16px;">@g.Title</h6>
                                        <div class="small" style="color: var(--text-secondary);">
                                            @if (!string.IsNullOrWhiteSpace(g.Genres))
                                            {
                                                <span><i class="fas fa-tag"></i> @g.Genres</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="mb-3 flex-grow-1">
                                        <small style="color: var(--text-tertiary); line-height: 1.5;">
                                            @if (!string.IsNullOrWhiteSpace(g.Description))
                                            {
                                                @g.Description.Substring(0, Math.Min(100, g.Description.Length))@(g.Description.Length > 100 ? "..." : "")
                                            }
                                        </small>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(g.Platforms))
                                            {
                                                <small style="color: var(--text-secondary);">
                                                    <i class="fas fa-gamepad"></i> @g.Platforms
                                                </small>
                                            }
                                        </div>
                                        <div class="fw-600" style="color: var(--accent-primary); font-size: 14px;">
                                            @(g.Price?.ToString("฿#,##0.00") ?? "—")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.q) || !string.IsNullOrWhiteSpace(Model.genre) || !string.IsNullOrWhiteSpace(Model.platform) || Model.minRating != null)
    {
        <!-- No Results Message -->
        <div class="alert alert-info d-flex align-items-center" role="alert" style="background-color: var(--bg-secondary); border-color: var(--accent-primary); color: var(--text-primary);">
            <i class="fas fa-info-circle me-3" style="font-size: 20px; color: var(--accent-primary);"></i>
            <div>
                <strong>ไม่พบผลลัพธ์</strong>
                <p class="mb-0 small">ลองเปลี่ยนเงื่อนไขการค้นหาหรือเลื่อนลงดูตัวเลือกเพิ่มเติม</p>
            </div>
        </div>
    }
    else
    {
        <!-- Welcome Message -->
        <div class="text-center py-5" style="color: var(--text-secondary);">
            <i class="fas fa-search" style="font-size: 48px; color: var(--accent-primary); opacity: 0.3; margin-bottom: 15px;"></i>
            <p class="lead">เริ่มค้นหาเกมที่คุณชอบ!</p>
            <p class="text-muted">ใช้ฟิลเตอร์ด้านบนเพื่อค้นหาเกมที่คุณชื่นชอบ</p>
        </div>
    }
</div>

<style>
    .page-header {
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
    }

    .search-form label {
        color: var(--text-primary);
    }

    .form-control, .form-select {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        border-color: var(--border-color) !important;
    }

    .form-control:focus {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        border-color: var(--accent-primary) !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 102, 204, 0.15);
    }

    .form-control::placeholder {
        color: var(--text-tertiary);
        opacity: 0.7;
    }

    .btn-group-sm > .btn {
        font-size: 13px;
    }

    .game-card {
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .game-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15) !important;
    }

    .game-card:hover .game-image img {
        transform: scale(1.05);
    }

    .game-card .card-body {
        color: var(--text-primary);
    }

    .results-section {
        animation: fadeIn 0.3s ease-in;
    }
</style>
