@using I_HAVE_GAME.Models

@{
    ViewData["Title"] = "Search History";
    var searchHistories = Model as List<SearchHistory> ?? new List<SearchHistory>();
}

<div class="search-history-container">
    <div class="search-history-header">
        <h1>🔍 Search History</h1>
        <p class="search-history-subtitle">View your game search activities</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (searchHistories.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">📝</div>
            <h3>No Search History Yet</h3>
            <p>You haven't searched for games yet. Start searching to build your history!</p>
            <a href="@Url.Action("Index", "Search")" class="btn btn-primary">
                <i class="fas fa-search"></i> Search Games
            </a>
        </div>
    }
    else
    {
        <div class="search-history-stats">
            <div class="stat-item">
                <span class="stat-label">Total Searches:</span>
                <span class="stat-value">@searchHistories.Count</span>
            </div>
            @{
                var lastSearch = searchHistories.OrderByDescending(s => s.SearchedAt).FirstOrDefault();
            }
            @if (lastSearch != null)
            {
                <div class="stat-item">
                    <span class="stat-label">Last Search:</span>
                    <span class="stat-value">@lastSearch.SearchedAt.ToString("MMM dd, yyyy HH:mm")</span>
                </div>
            }
        </div>

        <div class="search-history-list">
            @foreach (var record in searchHistories)
            {
                <div class="history-card">
                    <div class="history-header">
                        <div class="history-date">
                            <span class="date-icon">📅</span>
                            <span class="date-text">@record.SearchedAt.ToString("MMM dd, yyyy")</span>
                            <span class="time-text">@record.SearchedAt.ToString("HH:mm")</span>
                        </div>
                        <div class="history-result-count">
                            <span class="badge bg-primary">@record.ResultCount game(s) found</span>
                        </div>
                    </div>

                    <div class="history-details">
                        <div class="detail-row">
                            <div class="detail-item">
                                <span class="detail-label">Genre:</span>
                                <span class="detail-value">@(string.IsNullOrEmpty(record.Genre) ? "Any" : record.Genre)</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Device:</span>
                                <span class="detail-value">@(string.IsNullOrEmpty(record.Device) ? "Any" : record.Device)</span>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-item">
                                <span class="detail-label">Play Mode:</span>
                                <span class="detail-value">@(string.IsNullOrEmpty(record.PlayMode) ? "Any" : record.PlayMode)</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Budget:</span>
                                <span class="detail-value">@(string.IsNullOrEmpty(record.Budget) ? "Any" : record.Budget)</span>
                            </div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-item">
                                <span class="detail-label">Era:</span>
                                <span class="detail-value">@(string.IsNullOrEmpty(record.Era) ? "Any" : record.Era)</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="search-history-actions">
            <a href="@Url.Action("Index", "Search")" class="btn btn-outline-primary">
                <i class="fas fa-search"></i> New Search
            </a>
            <button type="button" class="btn btn-outline-danger" id="clearHistoryBtn" data-bs-toggle="modal" data-bs-target="#clearConfirmModal">
                <i class="fas fa-trash-alt"></i> Clear All History
            </button>
        </div>
    }
</div>

<!-- Clear Confirmation Modal -->
<div class="modal fade" id="clearConfirmModal" tabindex="-1" aria-labelledby="clearConfirmLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="clearConfirmLabel">Clear Search History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to clear all your search history?</p>
                <p class="text-muted">This action cannot be undone.</p>
                @if (searchHistories.Count > 0)
                {
                    <div class="alert alert-warning">
                        This will delete <strong>@searchHistories.Count</strong> search record(s).
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-action="Clear" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt"></i> Clear History
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .search-history-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
    }

    .search-history-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .search-history-header h1 {
        font-size: 32px;
        font-weight: bold;
        color: var(--accent-primary);
        margin-bottom: 10px;
    }

    .search-history-subtitle {
        color: var(--text-secondary);
        font-size: 16px;
        margin: 0;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background-color: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        border-style: dashed;
    }

    .empty-state-icon {
        font-size: 64px;
        margin-bottom: 20px;
    }

    .empty-state h3 {
        color: var(--text-primary);
        font-size: 24px;
        margin-bottom: 10px;
    }

    .empty-state p {
        color: var(--text-secondary);
        margin-bottom: 30px;
    }

    .search-history-stats {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
        padding: 20px;
        background-color: var(--bg-secondary);
        border-radius: 12px;
        flex-wrap: wrap;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .stat-label {
        color: var(--text-secondary);
        font-size: 14px;
        font-weight: 600;
    }

    .stat-value {
        color: var(--accent-primary);
        font-size: 18px;
        font-weight: bold;
    }

    .search-history-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-bottom: 30px;
    }

    .history-card {
        background-color: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 20px;
        transition: all 0.3s ease;
        box-shadow: 0 2px 4px var(--shadow-light);
    }

    .history-card:hover {
        box-shadow: 0 4px 8px var(--shadow-medium);
        border-color: var(--accent-primary);
    }

    .history-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        gap: 10px;
        flex-wrap: wrap;
    }

    .history-date {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .date-icon {
        font-size: 18px;
    }

    .date-text {
        color: var(--text-primary);
        font-weight: 600;
        font-size: 14px;
    }

    .time-text {
        color: var(--text-secondary);
        font-size: 13px;
    }

    .history-result-count {
        white-space: nowrap;
    }

    .history-result-count .badge {
        padding: 6px 12px;
        font-size: 13px;
    }

    .history-details {
        border-top: 1px solid var(--border-color);
        padding-top: 15px;
    }

    .detail-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-bottom: 12px;
    }

    @media (max-width: 576px) {
        .detail-row {
            grid-template-columns: 1fr;
        }
    }

    .detail-item {
        display: flex;
        flex-direction: column;
    }

    .detail-label {
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .detail-value {
        color: var(--text-primary);
        font-size: 14px;
    }

    .search-history-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .search-history-actions .btn {
        min-width: 150px;
    }

    /* Modal styling */
    .modal-content {
        background-color: var(--card-bg);
        border-color: var(--card-border);
        color: var(--text-primary);
    }

    .modal-header {
        border-bottom-color: var(--card-border);
    }

    .modal-footer {
        border-top-color: var(--card-border);
    }

    .modal-title {
        color: var(--text-primary);
    }

    .btn-close {
        filter: var(--text-primary) != "#1a1a1a" ? invert(1) : none;
    }

    html.dark-mode .btn-close {
        filter: invert(1);
    }
</style>
