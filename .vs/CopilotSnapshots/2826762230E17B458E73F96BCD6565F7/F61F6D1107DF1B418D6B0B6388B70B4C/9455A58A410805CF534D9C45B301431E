using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using I_HAVE_GAME.Data;
using I_HAVE_GAME.ViewModels;
using Microsoft.EntityFrameworkCore;
using System.Security.Claims;

namespace I_HAVE_GAME.Controllers
{
    [Authorize]
    public class SearchHistoryController : Controller
    {
        private readonly AppDbContext _dbContext;
        private readonly ILogger<SearchHistoryController> _logger;

        public SearchHistoryController(AppDbContext dbContext, ILogger<SearchHistoryController> logger)
        {
            _dbContext = dbContext;
            _logger = logger;
        }

        /// <summary>
        /// Get the current user's ID from claims
        /// </summary>
        private int GetCurrentUserId()
        {
            var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier);
            if (!int.TryParse(userIdClaim?.Value, out var userId))
            {
                throw new UnauthorizedAccessException("User ID not found in claims");
            }
            return userId;
        }

        /// <summary>
        /// Display user's search history (newest first)
        /// </summary>
        public async Task<IActionResult> Index()
        {
            try
            {
                var userId = GetCurrentUserId();

                // Get search history sorted by SearchedAt descending (newest first)
                var searchHistory = await _dbContext.SearchHistories
                    .Where(s => s.UserId == userId)
                    .OrderByDescending(s => s.SearchedAt)
                    .ToListAsync();

                return View(searchHistory);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error loading search history");
                return View("Error", ex.Message);
            }
        }

        /// <summary>
        /// Clear all search history for the current user
        /// </summary>
        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> Clear()
        {
            try
            {
                var userId = GetCurrentUserId();

                // Get all search history records for the current user
                var searchHistories = await _dbContext.SearchHistories
                    .Where(s => s.UserId == userId)
                    .ToListAsync();

                if (searchHistories.Count == 0)
                {
                    TempData["InfoMessage"] = "Your search history is already empty.";
                    return RedirectToAction("Index");
                }

                // Remove all records
                _dbContext.SearchHistories.RemoveRange(searchHistories);
                await _dbContext.SaveChangesAsync();

                _logger.LogInformation("User {UserId} cleared their search history ({RecordCount} records deleted).", userId, searchHistories.Count);

                TempData["SuccessMessage"] = $"✓ Cleared {searchHistories.Count} search history record(s).";
                return RedirectToAction("Index");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error clearing search history");
                TempData["ErrorMessage"] = "Error clearing search history. Please try again.";
                return RedirectToAction("Index");
            }
        }
    }
}
