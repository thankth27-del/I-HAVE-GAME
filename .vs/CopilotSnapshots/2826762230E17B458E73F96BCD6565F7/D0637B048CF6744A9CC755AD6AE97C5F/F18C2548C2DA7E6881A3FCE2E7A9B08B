@model I_HAVE_GAME.ViewModels.QuizQuestionFormViewModel

@{
    ViewData["Title"] = Model.FormTitle;
}

<style>
    :root {
        --admin-primary: #007bff;
        --admin-accent: #0056b3;
        --admin-bg-light: #ffffff;
        --admin-text-light: #212529;
        --admin-border-light: #dee2e6;
        --admin-danger: #dc3545;
    }

    html.dark-mode {
        --admin-primary: #4ba3ff;
        --admin-accent: #357abd;
        --admin-bg-light: #2a2a2a;
        --admin-text-light: #e9ecef;
        --admin-border-light: #495057;
        --admin-danger: #ff6b6b;
    }

    .admin-container {
        background: var(--admin-bg-light);
        color: var(--admin-text-light);
        min-height: calc(100vh - 200px);
        padding: 40px 20px;
    }

    .admin-wrapper {
        max-width: 700px;
        margin: 0 auto;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .admin-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--admin-primary);
        margin: 0;
    }

    .admin-back-btn {
        padding: 10px 20px;
        background: var(--admin-primary);
        color: white;
        border: none;
        border-radius: 6px;
        text-decoration: none;
        cursor: pointer;
        font-weight: 600;
        transition: background 0.3s ease;
    }

    .admin-back-btn:hover {
        background: var(--admin-accent);
        color: white;
    }

    .admin-card {
        background: var(--admin-bg-light);
        border: 2px solid var(--admin-primary);
        border-radius: 12px;
        padding: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: var(--admin-text-light);
    }

    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 12px;
        border: 1px solid var(--admin-border-light);
        border-radius: 6px;
        background: var(--admin-bg-light);
        color: var(--admin-text-light);
        font-family: inherit;
        font-size: 16px;
    }

    .form-group textarea:focus,
    .form-group select:focus {
        outline: none;
        border-color: var(--admin-primary);
        box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
    }

    .form-group textarea {
        min-height: 100px;
        resize: vertical;
    }

    .form-hint {
        font-size: 12px;
        color: var(--admin-text-light);
        opacity: 0.7;
        margin-top: 5px;
    }

    .invalid-feedback {
        display: block;
        color: var(--admin-danger);
        font-size: 14px;
        margin-top: 5px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .form-actions button,
    .form-actions a {
        flex: 1;
        padding: 12px 20px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        border: none;
        text-align: center;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: var(--admin-primary);
        color: white;
    }

    .btn-primary:hover {
        background: var(--admin-accent);
    }

    .btn-secondary {
        background: var(--admin-border-light);
        color: var(--admin-text-light);
        border: 1px solid var(--admin-border-light);
    }

    .btn-secondary:hover {
        background: #c3cfe0;
    }

    .alert {
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 6px;
        border-left: 4px solid;
    }

    .alert-danger {
        background: rgba(220, 53, 69, 0.1);
        border-color: var(--admin-danger);
        color: var(--admin-danger);
    }

    @media (max-width: 576px) {
        .admin-header {
            flex-direction: column;
            gap: 15px;
        }

        .admin-title {
            font-size: 24px;
        }

        .admin-back-btn {
            width: 100%;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column;
        }
    }
</style>

<div class="admin-container">
    <div class="admin-wrapper">
        <div class="admin-header">
            <h1 class="admin-title">@Model.FormTitle</h1>
            <a href="@Url.Action("QuizQuestionList", "Admin")" class="admin-back-btn">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> Please correct the errors below.
            </div>
        }

        <div class="admin-card">
            <form method="post" asp-action="@(Model.IsEdit ? "EditQuestion" : "CreateQuestion")">
                @if (Model.IsEdit)
                {
                    <input type="hidden" name="id" value="@Model.Id" />
                }
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="QuestionText">Question Text *</label>
                    <textarea asp-for="QuestionText" placeholder="Enter the quiz question..."></textarea>
                    <span asp-validation-for="QuestionText" class="invalid-feedback"></span>
                    <div class="form-hint">What should the player answer?</div>
                </div>

                <div class="form-group">
                    <label asp-for="CorrectAnswer">Correct Answer *</label>
                    <textarea asp-for="CorrectAnswer" placeholder="Enter the correct answer..."></textarea>
                    <span asp-validation-for="CorrectAnswer" class="invalid-feedback"></span>
                    <div class="form-hint">This must match exactly one of the options below.</div>
                </div>

                <fieldset class="form-group">
                    <legend style="font-weight: 600; margin-bottom: 15px;">Answer Options *</legend>

                    <div class="form-group" style="margin-bottom: 15px;">
                        <label asp-for="Choice1">Option 1</label>
                        <textarea asp-for="Choice1" placeholder="Enter first option..."></textarea>
                        <span asp-validation-for="Choice1" class="invalid-feedback"></span>
                    </div>

                    <div class="form-group" style="margin-bottom: 15px;">
                        <label asp-for="Choice2">Option 2</label>
                        <textarea asp-for="Choice2" placeholder="Enter second option..."></textarea>
                        <span asp-validation-for="Choice2" class="invalid-feedback"></span>
                    </div>

                    <div class="form-group" style="margin-bottom: 15px;">
                        <label asp-for="Choice3">Option 3</label>
                        <textarea asp-for="Choice3" placeholder="Enter third option..."></textarea>
                        <span asp-validation-for="Choice3" class="invalid-feedback"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Choice4">Option 4</label>
                        <textarea asp-for="Choice4" placeholder="Enter fourth option..."></textarea>
                        <span asp-validation-for="Choice4" class="invalid-feedback"></span>
                    </div>
                </fieldset>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-save"></i> @(Model.IsEdit ? "Update Question" : "Create Question")
                    </button>
                    <a href="@Url.Action("QuizQuestionList", "Admin")" class="btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
