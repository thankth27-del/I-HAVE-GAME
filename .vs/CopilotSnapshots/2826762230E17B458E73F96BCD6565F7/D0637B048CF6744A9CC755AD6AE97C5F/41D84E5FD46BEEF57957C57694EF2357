@{
    ViewData["Title"] = "Quiz - Guess the Game";
}

<style>
    :root {
        --quiz-primary: #007bff;
        --quiz-accent: #0056b3;
        --quiz-bg-light: #ffffff;
        --quiz-text-light: #212529;
        --quiz-border-light: #dee2e6;
    }

    html.dark-mode {
        --quiz-primary: #4ba3ff;
        --quiz-accent: #357abd;
        --quiz-bg-light: #2a2a2a;
        --quiz-text-light: #e9ecef;
        --quiz-border-light: #495057;
    }

    .quiz-container {
        background: var(--quiz-bg-light);
        color: var(--quiz-text-light);
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .quiz-card {
        background: var(--quiz-bg-light);
        border: 2px solid var(--quiz-primary);
        border-radius: 12px;
        padding: 50px 40px;
        max-width: 600px;
        width: 100%;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }

    .quiz-title {
        font-size: 48px;
        font-weight: 700;
        color: var(--quiz-primary);
        margin-bottom: 20px;
        text-align: center;
    }

    .quiz-subtitle {
        font-size: 24px;
        color: var(--quiz-text-light);
        margin-bottom: 30px;
        text-align: center;
    }

    .quiz-rules {
        background: rgba(0, 123, 255, 0.1);
        border-left: 4px solid var(--quiz-primary);
        padding: 20px;
        margin: 30px 0;
        border-radius: 6px;
    }

    .quiz-rules h3 {
        color: var(--quiz-primary);
        margin-top: 0;
        font-size: 18px;
    }

    .quiz-rules ul {
        margin: 0;
        padding-left: 20px;
    }

    .quiz-rules li {
        margin: 8px 0;
        line-height: 1.6;
    }

    .quiz-start-btn {
        background: var(--quiz-primary);
        border: none;
        color: white;
        padding: 15px 40px;
        font-size: 18px;
        font-weight: 600;
        border-radius: 6px;
        cursor: pointer;
        width: 100%;
        transition: background 0.3s ease;
    }

    .quiz-start-btn:hover {
        background: var(--quiz-accent);
        color: white;
        text-decoration: none;
    }

    .quiz-icon {
        font-size: 60px;
        margin-bottom: 20px;
        text-align: center;
        color: var(--quiz-primary);
    }
</style>

<style media="(max-width: 576px)">
    .quiz-card {
        padding: 30px 20px;
    }

    .quiz-title {
        font-size: 32px;
    }

    .quiz-subtitle {
        font-size: 18px;
    }

    .quiz-icon {
        font-size: 48px;
    }

    .quiz-rules {
        padding: 15px;
    }

    .quiz-rules h3 {
        font-size: 16px;
    }
</style>

<div class="quiz-container">
    <div class="quiz-card">
        <div class="quiz-icon">
            <i class="fas fa-gamepad"></i>
        </div>
        <div class="quiz-title">Guess the Game</div>
        <div class="quiz-subtitle">Can you identify the game from the clue?</div>

        <div class="quiz-rules">
            <h3><i class="fas fa-info-circle"></i> Game Rules</h3>
            <ul>
                <li><strong>5 Questions</strong> per round</li>
                <li><strong>4 Choices</strong> for each question</li>
                <li><strong>1 Point</strong> for each correct answer</li>
                <li><strong>Maximum Score:</strong> 5 Points</li>
                <li>Choose carefully - you can only answer once!</li>
                <li>Track your highest scores in the history section</li>
            </ul>
        </div>

        <a href="@Url.Action("Play", "Quiz")" class="quiz-start-btn">
            <i class="fas fa-play"></i> Start Quiz
        </a>
    </div>
</div>
