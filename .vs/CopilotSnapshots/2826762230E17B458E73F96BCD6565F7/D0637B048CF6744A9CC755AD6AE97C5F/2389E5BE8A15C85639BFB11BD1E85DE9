<div class="admin-container">
    <div class="admin-wrapper">
        <div class="admin-header">
            <h1 class="admin-title">
                <i class="fas fa-question-circle"></i> Quiz Questions
            </h1>
            <div class="admin-actions">
                <button onclick="history.back()" class="admin-btn admin-btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back
                </button>
                <a href="@Url.Action("CreateQuestion", "Admin")" class="admin-btn">
                    <i class="fas fa-plus"></i> Add Question
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            </div>
        }

        @if (Model.Count > 0)
        {
            <div class="stats-box">
                <div class="stat-item">
                    <div class="stat-icon">
                        <i class="fas fa-list"></i>
                    </div>
                    <div>
                        <h3>Total Questions</h3>
                        <p class="stat-value">@Model.Count</p>
                    </div>
                </div>
            </div>

            <div class="admin-card">
                <div class="admin-table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Question</th>
                                <th style="width: 200px;">Correct Answer</th>
                                <th style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var question in Model)
                            {
                                <tr>
                                    <td class="question-text" title="@question.QuestionText">
                                        @question.QuestionText
                                    </td>
                                    <td class="answer-text" title="@question.CorrectAnswer">
                                        @question.CorrectAnswer
                                    </td>
                                    <td>
                                        <div class="table-actions">
                                            <a href="@Url.Action("EditQuestion", "Admin", new { id = question.Id })" class="action-btn action-btn-edit">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <form method="post" asp-action="DeleteQuestion" asp-route-id="@question.Id" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this question?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-btn action-btn-delete">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="admin-card">
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fas fa-inbox"></i>
                    </div>
                    <div class="empty-state-text">No quiz questions added yet.</div>
                    <a href="@Url.Action("CreateQuestion", "Admin")" class="admin-btn">
                        <i class="fas fa-plus"></i> Create First Question
                    </a>
                </div>
            </div>
        }
    </div>
</div>
