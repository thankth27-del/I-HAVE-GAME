@model List<I_HAVE_GAME.ViewModels.QuizQuestionListViewModel>

@{
    ViewData["Title"] = "Quiz Questions Management";
}

<style>
    :root {
        --admin-primary: #007bff;
        --admin-accent: #0056b3;
        --admin-success: #28a745;
        --admin-warning: #ffc107;
        --admin-danger: #dc3545;
        --admin-bg-light: #ffffff;
        --admin-text-light: #212529;
        --admin-border-light: #dee2e6;
    }

    html.dark-mode {
        --admin-primary: #4ba3ff;
        --admin-accent: #357abd;
        --admin-success: #51cf66;
        --admin-warning: #ffd43b;
        --admin-danger: #ff6b6b;
        --admin-bg-light: #2a2a2a;
        --admin-text-light: #e9ecef;
        --admin-border-light: #495057;
    }

    .admin-container {
        background: var(--admin-bg-light);
        color: var(--admin-text-light);
        min-height: calc(100vh - 200px);
        padding: 40px 20px;
    }

    .admin-wrapper {
        max-width: 1000px;
        margin: 0 auto;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .admin-title {
        font-size: 32px;
        font-weight: 700;
        color: var(--admin-primary);
        margin: 0;
    }

    .admin-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .admin-btn {
        padding: 10px 20px;
        background: var(--admin-primary);
        color: white;
        border: none;
        border-radius: 6px;
        text-decoration: none;
        cursor: pointer;
        font-weight: 600;
        transition: background 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .admin-btn:hover {
        background: var(--admin-accent);
        color: white;
    }

    .admin-btn-secondary {
        background: var(--admin-border-light);
        color: var(--admin-text-light);
    }

    .admin-btn-secondary:hover {
        background: #c3cfe0;
    }

    .admin-card {
        background: var(--admin-bg-light);
        border: 2px solid var(--admin-primary);
        border-radius: 12px;
        overflow: hidden;
    }

    .admin-table-wrapper {
        overflow-x: auto;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

    .admin-table thead {
        background: rgba(0, 123, 255, 0.1);
        border-bottom: 2px solid var(--admin-primary);
    }

    .admin-table th {
        padding: 15px;
        text-align: left;
        font-weight: 600;
        color: var(--admin-primary);
    }

    .admin-table td {
        padding: 15px;
        border-bottom: 1px solid var(--admin-border-light);
    }

    .admin-table tbody tr:hover {
        background: rgba(0, 123, 255, 0.05);
    }

    .question-text {
        max-width: 300px;
        word-break: break-word;
    }

    .answer-text {
        font-weight: 600;
        color: var(--admin-success);
    }

    .table-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .action-btn {
        padding: 6px 12px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.3s ease;
    }

    .action-btn-edit {
        background: var(--admin-warning);
        color: #000;
    }

    .action-btn-edit:hover {
        background: #e0ac00;
    }

    .action-btn-delete {
        background: var(--admin-danger);
        color: white;
    }

    .action-btn-delete:hover {
        background: #c82333;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

    .empty-state-icon {
        font-size: 80px;
        color: var(--admin-border-light);
        margin-bottom: 20px;
    }

    .empty-state-text {
        font-size: 18px;
        color: var(--admin-text-light);
        margin-bottom: 20px;
    }

    .stats-box {
        background: var(--admin-bg-light);
        border: 2px solid var(--admin-primary);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .stat-icon {
        font-size: 32px;
        color: var(--admin-primary);
    }

    .stat-info h3 {
        margin: 0;
        font-size: 14px;
        color: var(--admin-text-light);
        opacity: 0.7;
        text-transform: uppercase;
    }

    .stat-value {
        margin: 0;
        font-size: 24px;
        font-weight: 700;
        color: var(--admin-primary);
    }

    .alert {
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 6px;
        border-left: 4px solid;
    }

    .alert-success {
        background: rgba(40, 167, 69, 0.1);
        border-color: var(--admin-success);
        color: var(--admin-success);
    }

    .alert-danger {
        background: rgba(220, 53, 69, 0.1);
        border-color: var(--admin-danger);
        color: var(--admin-danger);
    }
</style>

<style media="(max-width: 576px)">
    .admin-header {
        flex-direction: column;
    }

    .admin-title {
        font-size: 24px;
    }

    .admin-actions {
        width: 100%;
    }

    .admin-btn {
        flex: 1;
        justify-content: center;
    }

    .admin-table {
        font-size: 14px;
    }

    .admin-table th,
    .admin-table td {
        padding: 10px;
    }

    .admin-table th {
        font-size: 9px;
    }

    .question-text {
        max-width: 150px;
    }

    .table-actions {
        flex-direction: column;
    }

    .action-btn {
        width: 100%;
        justify-content: center;
    }

    .stats-box {
        flex-direction: column;
        align-items: flex-start;
    }
</style>

