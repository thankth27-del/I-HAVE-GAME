@page
@model I_HAVE_GAME.Pages.SearchModel
@{
    ViewData["Title"] = "Search Games";
}

<link rel="stylesheet" href="~/css/search-page.css" />

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-lg-11 col-xl-10">
            <!-- Page Header -->
            <div class="page-header mb-5">
                <div class="mb-3">
                    <h1 class="display-5 fw-bold mb-2" style="color: var(--accent-primary);">
                        <i class="fas fa-search"></i> ค้นหาเกม
                    </h1>
                    <p class="lead text-secondary mb-0">
                        ค้นหาเกมที่ชอบของคุณจากห้องสมุดเกมที่มีขนาดใหญ่
                    </p>
                </div>
            </div>

            <!-- Search Form Card -->
            <div class="search-form-card card shadow-lg mb-5" style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px;">
                <div class="card-body p-4 p-lg-5">
                    <form method="get" class="search-form">
                        <div class="row g-3">
                            <!-- Main Search Input -->
                            <div class="col-lg-5">
                                <label class="form-label fw-600 mb-2 d-flex align-items-center gap-2">
                                    <i class="fas fa-search" style="color: var(--accent-primary);"></i> 
                                    <span>ค้นหา</span>
                                </label>
                                <input 
                                    class="form-control form-control-lg search-input" 
                                    type="text" 
                                    name="q" 
                                    value="@Model.q" 
                                    placeholder="ค้นหาชื่อ, แท็ก, หรือคำอธิบาย..." 
                                />
                                <small class="form-text text-secondary mt-1">ค้นหาจากชื่อเกม แท็ก หรือคำอธิบาย</small>
                            </div>

                            <!-- Genre Filter -->
                            <div class="col-md-6 col-lg-2">
                                <label class="form-label fw-600 mb-2 d-flex align-items-center gap-2">
                                    <i class="fas fa-tag" style="color: var(--accent-primary);"></i> 
                                    <span>ประเภท</span>
                                </label>
                                <input 
                                    class="form-control form-control-lg search-input" 
                                    type="text" 
                                    name="genre" 
                                    value="@Model.genre" 
                                    placeholder="เช่น Action, RPG..." 
                                />
                            </div>

                            <!-- Platform Filter -->
                            <div class="col-md-6 col-lg-2">
                                <label class="form-label fw-600 mb-2 d-flex align-items-center gap-2">
                                    <i class="fas fa-gamepad" style="color: var(--accent-primary);"></i> 
                                    <span>แพลตฟอร์ม</span>
                                </label>
                                <input 
                                    class="form-control form-control-lg search-input" 
                                    type="text" 
                                    name="platform" 
                                    value="@Model.platform" 
                                    placeholder="เช่น PC, PS5..." 
                                />
                            </div>

                            <!-- Rating Filter -->
                            <div class="col-md-6 col-lg-2">
                                <label class="form-label fw-600 mb-2 d-flex align-items-center gap-2">
                                    <i class="fas fa-star" style="color: var(--accent-primary);"></i> 
                                    <span>คะแนน</span>
                                </label>
                                <input 
                                    class="form-control form-control-lg search-input" 
                                    type="number" 
                                    step="0.1" 
                                    min="0" 
                                    max="5"
                                    name="minRating" 
                                    value="@(Model.minRating?.ToString() ?? string.Empty)" 
                                    placeholder="ตั้งแต่..." 
                                />
                            </div>

                            <!-- Search Button -->
                            <div class="col-md-6 col-lg-1 d-flex align-items-end">
                                <button class="btn btn-primary btn-lg w-100 search-btn" type="submit">
                                    <i class="fas fa-search"></i> <span class="d-none d-md-inline">ค้นหา</span>
                                </button>
                            </div>
                        </div>

                        <!-- Quick Filters (Optional) -->
                        <div class="mt-4 pt-4 border-top border-secondary-subtle">
                            <small class="text-secondary d-block mb-3" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                                <i class="fas fa-bolt"></i> ลองค้นหาด้วย:
                            </small>
                            <div class="quick-filters d-flex flex-wrap gap-2">
                                <a href="?genre=Action" class="btn btn-sm btn-outline-primary quick-filter-btn">
                                    <i class="fas fa-bolt"></i> Action
                                </a>
                                <a href="?genre=RPG" class="btn btn-sm btn-outline-primary quick-filter-btn">
                                    <i class="fas fa-sword"></i> RPG
                                </a>
                                <a href="?genre=Indie" class="btn btn-sm btn-outline-primary quick-filter-btn">
                                    <i class="fas fa-heart"></i> Indie
                                </a>
                                <a href="?genre=Puzzle" class="btn btn-sm btn-outline-primary quick-filter-btn">
                                    <i class="fas fa-cube"></i> Puzzle
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Results Section -->
            @if (Model.Results?.Any() == true)
            {
                <div class="results-section">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold mb-0" style="color: var(--text-primary);">
                            <i class="fas fa-list-ul"></i> ผลลัพธ์ (@Model.Results.Count() เกม)
                        </h4>
                    </div>

                    <div class="row g-4">
                        @foreach (var g in Model.Results)
                        {
                            <div class="col-lg-6">
                                <a href="#" class="game-card card shadow h-100" style="border: 1px solid var(--border-color); background-color: var(--card-bg); cursor: pointer; text-decoration: none; overflow: hidden; transition: all 0.3s ease; border-radius: 10px;">
                                    <div class="card-body d-flex p-0">
                                        <!-- Game Image -->
                                        <div class="game-image position-relative" style="width: 150px; flex-shrink: 0; overflow: hidden;">
                                            <img 
                                                src="@(string.IsNullOrWhiteSpace(g.ImageUrl) ? "/images/placeholder.svg" : g.ImageUrl)" 
                                                alt="@g.Title" 
                                                class="h-100" 
                                                style="width: 100%; object-fit: cover; transition: transform 0.3s ease;"
                                                onerror="this.src='/images/placeholder.svg'"
                                            />
                                            <div class="position-absolute top-0 end-0 m-2" style="background: var(--accent-primary); color: white; padding: 6px 10px; border-radius: 6px; font-weight: bold; font-size: 13px; box-shadow: 0 2px 8px rgba(0, 212, 255, 0.3);">
                                                ⭐ @(g.Rating?.ToString("0.0") ?? "—")
                                            </div>
                                        </div>

                                        <!-- Game Info -->
                                        <div class="p-4 flex-grow-1 d-flex flex-column" style="color: var(--text-primary);">
                                            <div class="mb-2">
                                                <h6 class="fw-700 mb-1" style="font-size: 16px;">@g.Title</h6>
                                                <div class="small" style="color: var(--text-secondary);">
                                                    @if (!string.IsNullOrWhiteSpace(g.Genres))
                                                    {
                                                        <span><i class="fas fa-tag"></i> @g.Genres</span>
                                                    }
                                                </div>
                                            </div>

                                            <div class="mb-3 flex-grow-1">
                                                <small style="color: var(--text-tertiary); line-height: 1.5;">
                                                    @if (!string.IsNullOrWhiteSpace(g.Description))
                                                    {
                                                        @g.Description.Substring(0, Math.Min(100, g.Description.Length))@(g.Description.Length > 100 ? "..." : "")
                                                    }
                                                </small>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    @if (!string.IsNullOrWhiteSpace(g.Platforms))
                                                    {
                                                        <small style="color: var(--text-secondary);">
                                                            <i class="fas fa-gamepad"></i> @g.Platforms
                                                        </small>
                                                    }
                                                </div>
                                                <div class="fw-600" style="color: var(--accent-primary); font-size: 14px;">
                                                    @(g.Price?.ToString("฿#,##0.00") ?? "—")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Model.q) || !string.IsNullOrWhiteSpace(Model.genre) || !string.IsNullOrWhiteSpace(Model.platform) || Model.minRating != null)
            {
                <!-- No Results Message -->
                <div class="alert alert-info d-flex align-items-center p-4" role="alert" style="background-color: var(--bg-secondary); border: 1px solid var(--accent-primary); color: var(--text-primary); border-radius: 10px;">
                    <i class="fas fa-info-circle me-3" style="font-size: 24px; color: var(--accent-primary);"></i>
                    <div>
                        <strong>ไม่พบผลลัพธ์</strong>
                        <p class="mb-0 small mt-1">ลองเปลี่ยนเงื่อนไขการค้นหาหรือเลื่อนลงดูตัวเลือกลงดูตัวเลือกด้านบน</p>
                    </div>
                </div>
            }
            else
            {
                <!-- Welcome Message -->
                <div class="text-center py-5" style="color: var(--text-secondary);">
                    <i class="fas fa-search" style="font-size: 64px; color: var(--accent-primary); opacity: 0.15; margin-bottom: 15px; display: block;"></i>
                    <p class="lead fw-500">เริ่มค้นหาเกมที่คุณชอบ!</p>
                    <p class="text-muted">ใช้ฟิลเตอร์ด้านบนเพื่อค้นหาเกมที่คุณชื่นชอบ</p>
                </div>
            }
        </div>
    </div>
</div>
