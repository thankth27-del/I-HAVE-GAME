@model GameSearchViewModel
@using I_HAVE_GAME.ViewModels

@{
    ViewData["Title"] = "Search New Games";
}

@Html.AntiForgeryToken()

<div class="search-container">
    <div class="search-header">
        <h1>🎮 Search New Games</h1>
        <div class="step-indicator">
            <span class="step-number">STEP @Model.CurrentStep / 5</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.WarningMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>Notice:</strong> @Model.WarningMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.IsLoading)
    {
        <div class="loading-state text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Searching for games...</p>
        </div>
    }

    @if (Model.CurrentStep >= 1 && Model.CurrentStep <= 5 && !Model.IsLoading && Model.Results.Count == 0)
    {
        <form method="post" class="search-form">
            @Html.AntiForgeryToken()

            <div class="form-group mb-4">
                @switch (Model.CurrentStep)
                {
                    case 1:
                        <label class="form-label">What type of game are you looking for?</label>
                        <div class="options-grid">
                            @foreach (var option in GameSearchViewModel.GenreOptions)
                            {
                                <div class="option-card">
                                    <input type="radio" class="btn-check" name="selectedGenre" id="genre_@option.Value" value="@option.Value" 
                                           @if (Model.SelectedGenre == option.Value) { <text>checked</text> } />
                                    <label class="btn btn-outline-primary btn-lg w-100" for="genre_@option.Value">
                                        @option.Label
                                    </label>
                                </div>
                            }
                        </div>
                        break;

                    case 2:
                        <input type="hidden" name="selectedGenre" value="@Model.SelectedGenre" />
                        <label class="form-label">What device do you play on?</label>
                        <div class="options-grid">
                            @foreach (var option in GameSearchViewModel.DeviceOptions)
                            {
                                <div class="option-card">
                                    <input type="radio" class="btn-check" name="selectedDevice" id="device_@option.Value" value="@option.Value" 
                                           @if (Model.SelectedDevice == option.Value) { <text>checked</text> } />
                                    <label class="btn btn-outline-primary btn-lg w-100" for="device_@option.Value">
                                        @option.Label
                                    </label>
                                </div>
                            }
                        </div>
                        break;

                    case 3:
                        <input type="hidden" name="selectedGenre" value="@Model.SelectedGenre" />
                        <input type="hidden" name="selectedDevice" value="@Model.SelectedDevice" />
                        <label class="form-label">How do you prefer to play?</label>
                        <div class="options-grid">
                            @foreach (var option in GameSearchViewModel.PlayModeOptions)
                            {
                                <div class="option-card">
                                    <input type="radio" class="btn-check" name="selectedPlayMode" id="playmode_@option.Value" value="@option.Value" 
                                           @if (Model.SelectedPlayMode == option.Value) { <text>checked</text> } />
                                    <label class="btn btn-outline-primary btn-lg w-100" for="playmode_@option.Value">
                                        @option.Label
                                    </label>
                                </div>
                            }
                        </div>
                        break;

                    case 4:
                        <input type="hidden" name="selectedGenre" value="@Model.SelectedGenre" />
                        <input type="hidden" name="selectedDevice" value="@Model.SelectedDevice" />
                        <input type="hidden" name="selectedPlayMode" value="@Model.SelectedPlayMode" />
                        <label class="form-label">What's your budget?</label>
                        <div class="options-grid">
                            @foreach (var option in GameSearchViewModel.BudgetOptions)
                            {
                                <div class="option-card">
                                    <input type="radio" class="btn-check" name="selectedBudget" id="budget_@option.Value" value="@option.Value" 
                                           @if (Model.SelectedBudget == option.Value) { <text>checked</text> } />
                                    <label class="btn btn-outline-primary btn-lg w-100" for="budget_@option.Value">
                                        @option.Label
                                    </label>
                                </div>
                            }
                        </div>
                        break;

                    case 5:
                        <input type="hidden" name="selectedGenre" value="@Model.SelectedGenre" />
                        <input type="hidden" name="selectedDevice" value="@Model.SelectedDevice" />
                        <input type="hidden" name="selectedPlayMode" value="@Model.SelectedPlayMode" />
                        <input type="hidden" name="selectedBudget" value="@Model.SelectedBudget" />
                        <label class="form-label">When do you want the game released?</label>
                        <div class="options-grid">
                            @foreach (var option in GameSearchViewModel.EraOptions)
                            {
                                <div class="option-card">
                                    <input type="radio" class="btn-check" name="selectedEra" id="era_@option.Value" value="@option.Value" 
                                           @if (Model.SelectedEra == option.Value) { <text>checked</text> } />
                                    <label class="btn btn-outline-primary btn-lg w-100" for="era_@option.Value">
                                        @option.Label
                                    </label>
                                </div>
                            }
                        </div>
                        break;
                }
            </div>

            <div class="button-group">
                @if (Model.CurrentStep > 1)
                {
                    <button type="submit" name="command" value="back" formaction="@Url.Action("GoBack")" class="btn btn-secondary btn-lg">
                        ← Back
                    </button>
                }

                @if (Model.CurrentStep < 5)
                {
                    <button type="submit" name="step" value="@(Model.CurrentStep + 1)" formaction="@Url.Action("Step" + Model.CurrentStep)" class="btn btn-primary btn-lg">
                        Next →
                    </button>
                }

                @if (Model.CurrentStep == 5)
                {
                    <button type="submit" formaction="@Url.Action("Search")" class="btn btn-success btn-lg">
                        🔍 Search Games
                    </button>
                }
            </div>
        </form>
    }

    @if (Model.Results.Count > 0)
    {
        <div class="results-section">
            <h2>Search Results (@Model.Results.Count games)</h2>

            <div class="results-grid">
                @foreach (var game in Model.Results)
                {
                    <div class="game-card">
                        @if (!string.IsNullOrWhiteSpace(game.BackgroundImage))
                        {
                            <div class="game-image" style="background-image: url('@game.BackgroundImage');">
                            </div>
                        }
                        else
                        {
                            <div class="game-image no-image">
                                <span>No Image</span>
                            </div>
                        }

                        <div class="game-info">
                            <h3>@game.Name</h3>

                            @if (!string.IsNullOrWhiteSpace(game.ReleasedDate))
                            {
                                <p class="release-date">📅 @game.ReleasedDate</p>
                            }

                            @if (game.Rating > 0)
                            {
                                <p class="rating">⭐ @game.Rating.ToString("F1") (@game.RatingsCount ratings)</p>
                            }

                            @if (game.Genres.Count > 0)
                            {
                                <div class="genres">
                                    @foreach (var genre in game.Genres.Take(3))
                                    {
                                        <span class="badge bg-info">@genre</span>
                                    }
                                </div>
                            }

                            @if (game.Platforms.Count > 0)
                            {
                                <div class="platforms">
                                    <strong>Platforms:</strong>
                                    @foreach (var platform in game.Platforms.Take(2))
                                    {
                                        <span class="platform-badge">@platform</span>
                                    }
                                    @if (game.Platforms.Count > 2)
                                    {
                                        <span class="platform-badge">+@(game.Platforms.Count - 2) more</span>
                                    }
                                </div>
                            }

                            @if (game.Stores.Count > 0)
                            {
                                <div class="stores">
                                    <strong>Available on:</strong>
                                    @foreach (var store in game.Stores.Take(2))
                                    {
                                        <span class="store-badge">@store</span>
                                    }
                                </div>
                            }

                            <!-- Add to Library Buttons -->
                            <div class="add-to-library-buttons">
                                <button type="button" class="btn btn-sm btn-wishlist add-btn" 
                                        data-game-id="@game.Id" data-game-slug="@game.Slug" 
                                        data-game-name="@game.Name" data-game-image="@game.BackgroundImage"
                                        data-game-genre="@string.Join(", ", game.Genres)"
                                        data-status="Wishlist" title="Add to Wishlist">
                                    🎯 Wishlist
                                </button>
                                <button type="button" class="btn btn-sm btn-backlog add-btn" 
                                        data-game-id="@game.Id" data-game-slug="@game.Slug" 
                                        data-game-name="@game.Name" data-game-image="@game.BackgroundImage"
                                        data-game-genre="@string.Join(", ", game.Genres)"
                                        data-status="Backlog" title="Add to Backlog">
                                    📋 Backlog
                                </button>
                                <button type="button" class="btn btn-sm btn-played add-btn" 
                                        data-game-id="@game.Id" data-game-slug="@game.Slug" 
                                        data-game-name="@game.Name" data-game-image="@game.BackgroundImage"
                                        data-game-genre="@string.Join(", ", game.Genres)"
                                        data-status="Played" title="Mark as Played">
                                    ✓ Played
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="pagination-controls mt-4">
                @if (Model.CurrentPage > 0)
                {
                    <form method="post" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="selectedGenre" value="@Model.SelectedGenre" />
                        <input type="hidden" name="selectedDevice" value="@Model.SelectedDevice" />
                        <input type="hidden" name="selectedPlayMode" value="@Model.SelectedPlayMode" />
                        <input type="hidden" name="selectedBudget" value="@Model.SelectedBudget" />
                        <input type="hidden" name="selectedEra" value="@Model.SelectedEra" />
                        <input type="hidden" name="currentPage" value="@(Model.CurrentPage - 1)" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        <button type="submit" formaction="@Url.Action("Search")" class="btn btn-outline-primary">
                            ← Previous Page
                        </button>
                    </form>
                }

                <span class="page-info">Page @(Model.CurrentPage + 1) of ~@Math.Ceiling((double)Model.TotalResults / Model.PageSize)</span>

                @if ((Model.CurrentPage + 1) * Model.PageSize < Model.TotalResults)
                {
                    <form method="post" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="selectedGenre" value="@Model.SelectedGenre" />
                        <input type="hidden" name="selectedDevice" value="@Model.SelectedDevice" />
                        <input type="hidden" name="selectedPlayMode" value="@Model.SelectedPlayMode" />
                        <input type="hidden" name="selectedBudget" value="@Model.SelectedBudget" />
                        <input type="hidden" name="selectedEra" value="@Model.SelectedEra" />
                        <input type="hidden" name="currentPage" value="@(Model.CurrentPage + 1)" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                        <button type="submit" formaction="@Url.Action("Search")" class="btn btn-outline-primary">
                            Next Page →
                        </button>
                    </form>
                }

                <form method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" formaction="@Url.Action("Index")" class="btn btn-secondary">
                        ← Start Over
                    </button>
                </form>
            </div>
        </div>
    }
</div>

<style>
    .search-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 2rem;
        background-color: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
    }

    .search-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .search-header h1 {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
        color: var(--accent-primary);
    }

    .step-indicator {
        font-size: 1.1rem;
        color: var(--text-secondary);
        font-weight: 600;
        letter-spacing: 1px;
    }

    .search-form {
        background-color: var(--bg-secondary);
        padding: 2rem;
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .form-group label {
        font-size: 1.3rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        display: block;
        color: var(--text-primary);
    }

    .options-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .option-card .btn {
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.5px;
        border-width: 2px;
        transition: all 0.3s ease;
    }

    .option-card .btn-check:checked + .btn {
        background-color: var(--accent-primary);
        border-color: var(--accent-primary);
        color: white;
    }

    .button-group {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
    }

    .button-group .btn {
        min-width: 150px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .results-section {
        margin-top: 2rem;
    }

    .results-section h2 {
        font-size: 1.8rem;
        color: var(--accent-primary);
        margin-bottom: 2rem;
    }

    .results-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .game-card {
        background-color: var(--bg-secondary);
        border: 1px solid var(--card-border);
        border-radius: 8px;
        overflow: hidden;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .game-card:hover {
        border-color: var(--accent-primary);
        box-shadow: 0 0 12px var(--shadow-light);
        transform: translateY(-4px);
    }

    .game-image {
        width: 100%;
        height: 200px;
        background-size: cover;
        background-position: center;
        position: relative;
        overflow: hidden;
    }

    .game-image.no-image {
        background-color: var(--bg-tertiary);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent-primary);
        font-weight: 600;
    }

    .game-info {
        padding: 1.5rem;
    }

    .game-info h3 {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .release-date {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-bottom: 0.5rem;
    }

    .rating {
        font-size: 0.95rem;
        color: #ffc107;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .genres {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.3rem 0.6rem;
    }

    .platforms,
    .stores {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-bottom: 0.5rem;
    }

    .platform-badge,
    .store-badge {
        display: inline-block;
        background-color: transparent;
        border: 1px solid var(--accent-primary);
        color: var(--accent-primary);
        padding: 0.3rem 0.6rem;
        border-radius: 4px;
        font-size: 0.8rem;
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .loading-state {
        padding: 3rem;
        text-align: center;
    }

    .loading-state .spinner-border {
        width: 3rem;
        height: 3rem;
    }

    .loading-state p {
        margin-top: 1rem;
        color: var(--text-secondary);
    }

    .pagination-controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .page-info {
        color: var(--text-secondary);
        font-weight: 600;
    }

    .add-to-library-buttons {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-color);
    }

    .add-to-library-buttons .btn {
        flex: 1;
        min-width: 90px;
        font-size: 0.85rem;
        padding: 0.4rem 0.6rem;
        font-weight: 600;
        border: 1px solid;
        transition: all 0.3s ease;
    }

    .btn-wishlist {
        background-color: transparent;
        color: var(--accent-primary);
        border-color: var(--accent-primary);
    }

    .btn-wishlist:hover {
        background-color: rgba(0, 102, 204, 0.1);
    }

    .btn-backlog {
        background-color: transparent;
        color: #d4a017;
        border-color: #d4a017;
    }

    .btn-backlog:hover {
        background-color: rgba(212, 160, 23, 0.1);
    }

    .btn-played {
        background-color: transparent;
        color: #4caf50;
        border-color: #4caf50;
    }

    .btn-played:hover {
        background-color: rgba(76, 175, 80, 0.1);
    }

    @@media (max-width: 768px) {
        .options-grid {
            grid-template-columns: 1fr;
        }

        .button-group {
            flex-direction: column;
        }

        .button-group .btn {
            width: 100%;
        }

        .results-grid {
            grid-template-columns: 1fr;
        }

        .search-header h1 {
            font-size: 1.8rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const searchContainer = document.querySelector('.search-container');

        // Handle add to library buttons
        document.querySelectorAll('.add-btn').forEach(button => {
            button.addEventListener('click', async function (e) {
                e.preventDefault();

                const gameId = parseInt(this.dataset.gameId);
                const gameSlug = this.dataset.gameSlug;
                const gameName = this.dataset.gameName;
                const gameImage = this.dataset.gameImage;
                const gameGenre = this.dataset.gameGenre || ''; // Get genre from data attribute
                const status = this.dataset.status;

                // Disable button while processing
                this.disabled = true;
                const originalText = this.textContent;
                this.textContent = '⏳ Adding...';

                try {
                    const response = await fetch('@Url.Action("AddToLibrary", "GameLibrary")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': csrfToken
                        },
                        body: JSON.stringify({
                            gameId: gameId,
                            gameSlug: gameSlug,
                            gameName: gameName,
                            gameImageUrl: gameImage,
                            genre: gameGenre,
                            status: status
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        showNotification(data.message, 'success');
                        this.disabled = true;
                        this.textContent = '✓ Added';
                        this.classList.add('btn-success');
                        this.classList.remove('btn-wishlist', 'btn-backlog', 'btn-played');
                    } else {
                        showNotification(data.message, 'warning');
                        this.disabled = false;
                        this.textContent = originalText;
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showNotification('Error adding game to library', 'error');
                    this.disabled = false;
                    this.textContent = originalText;
                }
            });
        });

        // Show notification
        function showNotification(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            alertDiv.role = 'alert';
            alertDiv.style.position = 'fixed';
            alertDiv.style.top = '20px';
            alertDiv.style.right = '20px';
            alertDiv.style.zIndex = '9999';
            alertDiv.style.maxWidth = '400px';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;

            document.body.appendChild(alertDiv);

            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
        }
    });
</script>
