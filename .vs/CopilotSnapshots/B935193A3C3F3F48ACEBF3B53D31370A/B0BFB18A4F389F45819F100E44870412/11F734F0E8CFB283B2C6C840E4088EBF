/* Search Page Styles - Enhanced */

.page-header {
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--border-color);
    margin-bottom: 2rem;
}

.page-header h1 {
    letter-spacing: -0.5px;
}

/* Search Form Styling */
.search-form-card {
    transition: all 0.3s ease;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, rgba(22, 33, 62, 0.8) 100%);
}

.search-form-card:hover {
    box-shadow: 0 10px 30px rgba(0, 212, 255, 0.15) !important;
}

.search-form label {
    color: var(--text-primary);
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.search-input, .form-control, .form-select {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    border: 1px solid var(--border-color) !important;
    border-radius: 8px;
    transition: all 0.3s ease;
    height: 44px;
}

.search-input:hover, .form-control:hover, .form-select:hover {
    border-color: var(--accent-primary) !important;
}

.search-input:focus {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    border-color: var(--accent-primary) !important;
    box-shadow: 0 0 0 0.2rem rgba(0, 212, 255, 0.15);
}

.form-control:focus, .form-select:focus {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    border-color: var(--accent-primary) !important;
    box-shadow: 0 0 0 0.2rem rgba(0, 212, 255, 0.15);
}

.search-input::placeholder, .form-control::placeholder {
    color: var(--text-tertiary);
    opacity: 0.7;
}

/* Search Button Styling */
.search-btn {
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    border-radius: 8px;
    height: 44px;
}

.search-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 212, 255, 0.3);
}

.search-btn:active {
    transform: translateY(0);
}

/* Quick Filter Buttons */
.quick-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.quick-filter-btn {
    transition: all 0.3s ease;
    border-radius: 8px;
    border: 1px solid var(--accent-primary);
    color: var(--accent-primary);
    font-weight: 500;
    padding: 0.5rem 1rem;
}

.quick-filter-btn:hover {
    transform: translateY(-2px);
    background-color: var(--accent-primary);
    border-color: var(--accent-primary);
    color: white;
    box-shadow: 0 4px 12px rgba(0, 212, 255, 0.3);
}

/* Results Section */
.results-section {
    animation: fadeIn 0.3s ease-in;
}

/* Game Card Styling */
.game-card {
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid var(--card-border) !important;
    border-radius: 10px;
    overflow: hidden;
}

.game-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 28px rgba(0, 212, 255, 0.2) !important;
    border-color: var(--accent-primary) !important;
}

.game-card:hover .game-image img {
    transform: scale(1.08);
}

.game-card .card-body {
    color: var(--text-primary);
    padding: 0;
}

.game-image {
    position: relative;
    overflow: hidden;
    background-color: var(--bg-primary);
}

.game-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

/* Animation */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Alert Styling */
.alert {
    border-radius: 10px;
    border: 1px solid var(--accent-primary);
    animation: fadeIn 0.3s ease-in;
}

.alert-info {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
}

/* Responsive adjustments */
@media (max-width: 992px) {
    .display-5 {
        font-size: 36px !important;
    }
}

@media (max-width: 768px) {
    .display-5 {
        font-size: 32px !important;
    }

    .search-form-card .card-body {
        padding: 1.5rem !important;
    }

    .search-input, .form-control, .form-select {
        height: 40px;
        font-size: 15px;
    }

    .search-btn {
        height: 40px;
        font-size: 14px;
    }

    .game-image {
        width: 120px !important;
    }

    .page-header {
        margin-bottom: 1.5rem !important;
        padding-bottom: 1rem !important;
    }

    .page-header h1 {
        font-size: 28px !important;
    }

    .page-header p {
        font-size: 15px;
    }
}

@media (max-width: 576px) {
    .display-5 {
        font-size: 24px !important;
    }

    .quick-filters {
        gap: 0.5rem !important;
    }

    .quick-filter-btn {
        padding: 0.4rem 0.75rem;
        font-size: 12px;
        flex: 1 1 calc(50% - 0.25rem);
    }

    .game-image {
        width: 100px !important;
    }

    .game-card .card-body {
        padding: 0.75rem !important;
    }

    .search-form-card .card-body {
        padding: 1rem !important;
    }

    .search-input, .form-control, .form-select {
        height: 38px;
        font-size: 14px;
    }

    .row.g-4 {
        gap: 1rem !important;
    }

    .row.g-3 {
        gap: 0.75rem !important;
    }
}

