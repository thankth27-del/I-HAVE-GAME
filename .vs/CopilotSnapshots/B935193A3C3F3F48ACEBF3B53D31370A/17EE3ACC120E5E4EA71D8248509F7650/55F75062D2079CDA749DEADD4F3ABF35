@model GameSearchViewModel
@using I_HAVE_GAME.ViewModels

@{
    ViewData["Title"] = "ค้นหาเกมใหม่";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/search-page.css" asp-append-version="true" />

@Html.AntiForgeryToken()

<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-lg-11 col-xl-10">
            <!-- Search Header -->
            <div class="search-header mb-5">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <h1 class="display-5 fw-bold mb-0" style="color: var(--accent-primary);">
                        <i class="fas fa-gamepad"></i> ค้นหาเกมใหม่
                    </h1>
                </div>
                <p class="lead text-secondary mb-0">
                    เลือกตัวเลือกของคุณขั้นตอนละเรื่อย เราจะจับคู่เกมที่สมบูรณ์แบบสำหรับคุณ
                </p>
                <div class="step-indicator mt-3">
                    <small class="text-secondary" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                        <i class="fas fa-circle-check"></i> ขั้นตอนที่ @Model.CurrentStep จาก 5
                    </small>
                    <div class="progress mt-2" style="height: 6px; background-color: var(--bg-secondary);">
                        <div class="progress-bar" role="progressbar" style="width: @((Model.CurrentStep / 5.0) * 100)%; background-color: var(--accent-primary);" 
                             aria-valuenow="@Model.CurrentStep" aria-valuemin="0" aria-valuemax="5"></div>
                    </div>
                </div>
            </div>

            <!-- Alert Messages -->
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center p-4" role="alert" style="border: 1px solid #dc3545; border-radius: 10px; background-color: rgba(220, 53, 69, 0.1);">
                    <i class="fas fa-exclamation-circle me-3" style="font-size: 20px;"></i>
                    <div>
                        <strong>ข้อผิดพลาด</strong>
                        <p class="mb-0 small mt-1">@Model.ErrorMessage</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.WarningMessage))
            {
                <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center p-4" role="alert" style="border: 1px solid #ffc107; border-radius: 10px; background-color: rgba(255, 193, 7, 0.1);">
                    <i class="fas fa-info-circle me-3" style="font-size: 20px;"></i>
                    <div>
                        <strong>แจ้งเตือน</strong>
                        <p class="mb-0 small mt-1">@Model.WarningMessage</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Loading State -->
            @if (Model.IsLoading)
            {
                <div class="loading-state text-center py-5">
                    <div class="spinner-border mb-3" role="status" style="color: var(--accent-primary);">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="lead fw-500" style="color: var(--text-secondary);">กำลังค้นหาเกม...</p>
                    <p class="text-muted small">โปรดรอสักครู่</p>
                </div>
            }

            <!-- Search Form -->
            @if (Model.CurrentStep >= 1 && Model.CurrentStep <= 5 && !Model.IsLoading && Model.Results.Count == 0)
            {
                <form method="post" class="search-form-card card shadow-lg" style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 0;">
                    @Html.AntiForgeryToken()

                    <div class="card-body p-4 p-lg-5">
                        <div class="form-group mb-5">
                            <label class="form-label fw-bold mb-4 d-block" style="font-size: 18px; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.5px;">
                                @switch (Model.CurrentStep)
                                {
                                    case 1:
                                        <span><i class="fas fa-list"></i> ประเภทเกมที่คุณค้นหา?</span>
                                        break;
                                    case 2:
                                        <span><i class="fas fa-gamepad"></i> คุณเล่นบนอุปกรณ์ใด?</span>
                                        break;
                                    case 3:
                                        <span><i class="fas fa-users"></i> คุณชอบเล่นแบบไหน?</span>
                                        break;
                                    case 4:
                                        <span><i class="fas fa-wallet"></i> งบประมาณของคุณเท่าไหร่?</span>
                                        break;
                                    case 5:
                                        <span><i class="fas fa-calendar"></i> เกมเวลาไหนที่คุณอยากเล่น?</span>
                                        break;
                                }
                            </label>

                            <div class="options-grid">
                                @switch (Model.CurrentStep)
                                {
                                    case 1:
                                        @foreach (var option in GameSearchViewModel.GenreOptions)
                                        {
                                            <div class="option-card">
                                                <input type="radio" class="btn-check" name="selectedGenre" id="genre_@option.Value" value="@option.Value"
                                                       @if (Model.SelectedGenre == option.Value) { <text>checked</text> } />
                                                <label class="btn btn-lg option-btn w-100" for="genre_@option.Value">
                                                    @option.Label
                                                </label>
                                            </div>
                                        }
                                        break;

                                    case 2:
                                        <input type="hidden" name="selectedGenre" value="@Model.SelectedGenre" />
                                        @foreach (var option in GameSearchViewModel.DeviceOptions)
                                        {
                                            <div class="option-card">
                                                <input type="radio" class="btn-check" name="selectedDevice" id="device_@option.Value" value="@option.Value"
                                                       @if (Model.SelectedDevice == option.Value) { <text>checked</text> } />
                                                <label class="btn btn-lg option-btn w-100" for="device_@option.Value">
                                                    @option.Label
                                                </label>
                                            </div>
                                        }
                                        break;

                                    case 3:
                                        <input type="hidden" name="selectedGenre" value="@Model.SelectedGenre" />
                                        <input type="hidden" name="selectedDevice" value="@Model.SelectedDevice" />
                                        @foreach (var option in GameSearchViewModel.PlayModeOptions)
                                        {
                                            <div class="option-card">
                                                <input type="radio" class="btn-check" name="selectedPlayMode" id="playmode_@option.Value" value="@option.Value"
                                                       @if (Model.SelectedPlayMode == option.Value) { <text>checked</text> } />
                                                <label class="btn btn-lg option-btn w-100" for="playmode_@option.Value">
                                                    @option.Label
                                                </label>
                                            </div>
                                        }
                                        break;

                                    case 4:
                                        <input type="hidden" name="selectedGenre" value="@Model.SelectedGenre" />
                                        <input type="hidden" name="selectedDevice" value="@Model.SelectedDevice" />
                                        <input type="hidden" name="selectedPlayMode" value="@Model.SelectedPlayMode" />
                                        @foreach (var option in GameSearchViewModel.BudgetOptions)
                                        {
                                            <div class="option-card">
                                                <input type="radio" class="btn-check" name="selectedBudget" id="budget_@option.Value" value="@option.Value"
                                                       @if (Model.SelectedBudget == option.Value) { <text>checked</text> } />
                                                <label class="btn btn-lg option-btn w-100" for="budget_@option.Value">
                                                    @option.Label
                                                </label>
                                            </div>
                                        }
                                        break;

                                    case 5:
                                        <input type="hidden" name="selectedGenre" value="@Model.SelectedGenre" />
                                        <input type="hidden" name="selectedDevice" value="@Model.SelectedDevice" />
                                        <input type="hidden" name="selectedPlayMode" value="@Model.SelectedPlayMode" />
                                        <input type="hidden" name="selectedBudget" value="@Model.SelectedBudget" />
                                        @foreach (var option in GameSearchViewModel.EraOptions)
                                        {
                                            <div class="option-card">
                                                <input type="radio" class="btn-check" name="selectedEra" id="era_@option.Value" value="@option.Value"
                                                       @if (Model.SelectedEra == option.Value) { <text>checked</text> } />
                                                <label class="btn btn-lg option-btn w-100" for="era_@option.Value">
                                                    @option.Label
                                                </label>
                                            </div>
                                        }
                                        break;
                                }
                            </div>
                        </div>

                        <!-- Navigation Buttons -->
                        <div class="d-flex gap-2 justify-content-between mt-5 pt-4 border-top border-secondary-subtle">
                            @if (Model.CurrentStep > 1)
                            {
                                <button type="submit" name="action" value="previous" class="btn btn-outline-primary btn-lg px-4">
                                    <i class="fas fa-arrow-left"></i> ย้อนกลับ
                                </button>
                            }
                            else
                            {
                                <div></div>
                            }

                            @if (Model.CurrentStep < 5)
                            {
                                <button type="submit" name="action" value="next" class="btn btn-primary btn-lg px-4" style="font-weight: 600;">
                                    ถัดไป <i class="fas fa-arrow-right"></i>
                                </button>
                            }
                            else
                            {
                                <button type="submit" name="action" value="complete" class="btn btn-primary btn-lg px-5" style="font-weight: 600;">
                                    <i class="fas fa-search"></i> ค้นหาเกม
                                </button>
                            }
                        </div>
                    </div>
                </form>
            }

            <!-- Results Section -->
            @if (Model.Results.Count > 0)
            {
                <div class="results-section mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold mb-0" style="color: var(--text-primary);">
                            <i class="fas fa-star"></i> ผลลัพธ์ที่ขอแนะนำ (@Model.Results.Count เกม)
                        </h4>
                    </div>

                    <div class="row g-4">
                        @foreach (var game in Model.Results)
                        {
                            <div class="col-lg-6">
                                <div class="game-result-card card shadow-lg h-100" style="border: 1px solid var(--border-color); background-color: var(--card-bg); border-radius: 12px; overflow: hidden;">
                                    <div class="card-body d-flex flex-column p-0">
                                        @if (!string.IsNullOrEmpty(game.BackgroundImage))
                                        {
                                            <div class="game-poster" style="height: 200px; overflow: hidden; background-color: var(--bg-primary);">
                                                <img src="@game.BackgroundImage" alt="@game.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                            </div>
                                        }

                                        <div class="p-4">
                                            <div class="mb-3">
                                                <h5 class="fw-bold mb-2" style="color: var(--text-primary); font-size: 18px;">@game.Name</h5>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-secondary-subtle">
                                                @if (game.Rating > 0)
                                                {
                                                    <div style="color: var(--accent-primary); font-weight: 600;">
                                                        <i class="fas fa-star"></i> @game.Rating.ToString("0.0") / 10
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(game.ReleasedDate))
                                                {
                                                    <div style="color: var(--text-secondary); font-weight: 500;">
                                                        @game.ReleasedDate
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Empty State -->
            @if (!Model.IsLoading && (Model.CurrentStep == 0 || (Model.CurrentStep >= 1 && Model.CurrentStep <= 5 && Model.Results.Count == 0 && string.IsNullOrEmpty(Model.ErrorMessage))))
            {
                @if (Model.CurrentStep == 0)
                {
                    <div class="text-center py-5" style="color: var(--text-secondary);">
                        <i class="fas fa-search" style="font-size: 80px; color: var(--accent-primary); opacity: 0.15; display: block; margin-bottom: 20px;"></i>
                        <p class="lead fw-500 mb-2">เริ่มค้นหาเกมที่สมบูรณ์แบบ</p>
                        <p class="text-muted">ตอบคำถาม 5 ข้อช่วย AI ของเรา ค้นหาเกมที่เหมาะสมที่สุดสำหรับคุณ</p>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .search-header {
        padding-bottom: 1.5rem;
        border-bottom: 2px solid var(--border-color);
    }

    .search-form-card {
        transition: all 0.3s ease;
    }

    .search-form-card:hover {
        box-shadow: 0 10px 30px rgba(0, 212, 255, 0.15) !important;
    }

    .options-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
        margin: 0;
    }

    .option-card {
        position: relative;
    }

    .option-card .btn-check:checked + .option-btn {
        background-color: var(--accent-primary);
        border-color: var(--accent-primary);
        color: white;
        box-shadow: 0 4px 12px rgba(0, 212, 255, 0.3);
    }

    .option-btn {
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        background-color: var(--bg-primary);
        font-weight: 500;
        transition: all 0.3s ease;
        border-radius: 8px;
    }

    .option-btn:hover {
        border-color: var(--accent-primary);
        transform: translateY(-2px);
    }

    .btn-outline-primary {
        color: var(--accent-primary);
        border-color: var(--accent-primary);
    }

    .btn-outline-primary:hover {
        background-color: var(--accent-primary);
        border-color: var(--accent-primary);
        color: white;
        transform: translateY(-2px);
    }

    .btn-primary {
        background-color: var(--accent-primary);
        border-color: var(--accent-primary);
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: var(--accent-primary-hover);
        border-color: var(--accent-primary-hover);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 212, 255, 0.3);
    }

    .game-result-card {
        transition: all 0.3s ease;
        border: 1px solid var(--border-color) !important;
    }

    .game-result-card:hover {
        transform: translateY(-8px);
        border-color: var(--accent-primary) !important;
        box-shadow: 0 15px 35px rgba(0, 212, 255, 0.2) !important;
    }

    .game-result-card:hover .game-poster img {
        transform: scale(1.08);
    }

    .game-poster img {
        transition: transform 0.3s ease;
    }

    .results-section {
        animation: fadeIn 0.3s ease-in;
    }

    .loading-state {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .step-indicator {
        margin-top: 0.5rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .options-grid {
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 10px;
        }

        .display-5 {
            font-size: 32px !important;
        }

        .search-form-card .card-body {
            padding: 1.5rem !important;
        }
    }

    @@media (max-width: 576px) {
        .options-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .option-btn {
            font-size: 13px;
            padding: 0.75rem 0.5rem !important;
        }

        .display-5 {
            font-size: 24px !important;
        }

        .btn-lg {
            font-size: 14px;
            padding: 0.6rem 1rem !important;
        }

        .d-flex.gap-2 {
            flex-direction: column;
            gap: 0.75rem !important;
        }

        .d-flex.gap-2 .btn {
            flex: 1;
        }
    }
</style>

